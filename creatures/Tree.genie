creature Tree
// A tree that forks again and again, each limb shorter than the one it grows from, with a leaf at
// the end of every twig.
// Inspired by Tree, a Fantastic Avian Creatures design.

gene depth = 5 in 2..6 step 1  // how many times the limbs fork

pitch -90
back 4
limb(depth, 1)

part limb(level, size) {
  gene reach  = 3    in 1..5
  gene thick  = 0.5  in 0.15..1
  gene spread = 34.4 in 5.7..80.2  // how far each fork leans out from its limb
  gene shrink = 0.72 in 0.5..0.9   // each limb's size compared with the one it grows from
  gene forks  = 3    in 2..4 step 1
  gene turn   = 22.9 in 0..114.6   // how far round the forks turn
  gene bark   = hsv(28.8, 0.6, 0.5) in hsv(0, 0.2, 0.2)..hsv(360, 1, 1)
  gene leaf   = hsv(108, 0.8, 0.9) in hsv(0, 0.3, 0.4)..hsv(360, 1, 1)

  grow size
  shape tube
  colour bark
  branch {
    forward reach / 2
    lay { grow (thick, thick, reach) }
  }
  forward reach
  if level <= 0 {
    shape ball
    colour leaf
    grow 1.2
    lay
  } else {
    repeat forks as i {
      branch {
        roll 360 * i / forks + turn
        pitch spread
        limb(level - 1, shrink)
      }
    }
  }
}
