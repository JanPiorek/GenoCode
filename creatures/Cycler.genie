creature Cycler
// One big ball wearing banded clouds. The palette turns with time, and as the creature morphs
// round its members the bands themselves flow across the clouds, without ever jumping back.

gene speed  = 60 in -360..360  // how many degrees round the colour wheel the palette turns each second
gene hue    = 200   in 0..360
gene scheme = dusk  from [jewel, duotone, split, analogous, pastel, dusk, electric]
gene finish = iridescent from [matte, metallic, iridescent, pearl, satin]

shape ball
grow 8
texture pattern(Clouds, hue + speed * time, 7, scheme, finish)
wear 1
lay

pattern Clouds {
  gene bands  = 3 in 1..10 step 1  // how many times the colours repeat from thin cloud to thick
  gene detail = 6 in 1..10 step 1
  gene size   = 2 in 1..8 step 1
  // Where the bands sit, as a point on a circle: once round moves every band on to where the
  // next one was. A point rather than a number, so morphing always turns it the short way round.
  gene phase = (1, 0, 0) in (-1, -1, 0)..(1, 1, 0)

  let shift = atan2(phase.y, phase.x) / 360
  let sky = clouds(detail, size)
  value picture {
    let v = frac(sky * bands + shift + 1)
    value 1 - abs(2 * v - 1)
  }
}

// Each member turns the bands a fifth of the way on from the one before, so the morph loop keeps
// them flowing the same way all the way round.
variant Member2 { hue = 162.4; Clouds.phase = (0.309, 0.9511, 0) }

variant Member3 { hue = 220.7; Clouds.phase = (-0.809, 0.5878, 0) }

variant Member4 { hue = 158.9; Clouds.phase = (-0.809, -0.5878, 0) }

variant Member5 { hue = 138.7; Clouds.phase = (0.309, -0.9511, 0) }
