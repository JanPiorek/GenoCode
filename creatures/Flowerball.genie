creature Flowerball
// A ball of beads in rings, which opens out into a flat disc, crowned by five curling petals.
// Inspired by Flowerball, a DancerDNA creature.

gene open        = 0.7787 in 0..1       // 0 lays the beads flat in a disc; 1 rounds them into a ball and fills out the petals
gene gloss       = 1      in 0..1       // how strong the highlights are
gene focus       = 0.2688 in 0..1       // how tight the highlights are
gene lift        = 3.833  in -20..20    // how far from the beads the petals grow, as the creature opens
gene ball_radius = -2.893 in -10..15    // how big the ball the beads round into is; never less than 1
gene bead_size   = 0.5677 in 0.1..1
gene curl        = -2.292 in -2.5..2.5  // how far the petals curl

// The beads' colours, from the middle ring out, and the petals', from base to tip, with the
// gaps between them.
gene bead_1     = hsv(179.1, 0.74, 0.97) in hsv(0, 0.4, 0)..hsv(360, 1, 1)
gene bead_2     = hsv(261.3, 0.48, 0.57) in hsv(0, 0.4, 0)..hsv(360, 1, 1)
gene bead_3     = hsv(283.6, 0.47, 0.05) in hsv(0, 0.4, 0)..hsv(360, 1, 1)
gene bead_4     = hsv(172.1, 0.7, 0.92) in hsv(0, 0.4, 0)..hsv(360, 1, 1)
gene bead_gaps  = (0.7718, 0.1893, 0.4874) in (0.01, 0.01, 0.01)..(1, 1, 1)
gene petal_1    = hsv(4.3, 0.86, 0.02) in hsv(0, 0.4, 0)..hsv(360, 1, 1)
gene petal_2    = hsv(11.5, 0.95, 0.79) in hsv(0, 0.4, 0)..hsv(360, 1, 1)
gene petal_3    = hsv(233.6, 0.51, 0.41) in hsv(0, 0.4, 0)..hsv(360, 1, 1)
gene petal_4    = hsv(247.9, 0.76, 0.09) in hsv(0, 0.4, 0)..hsv(360, 1, 1)
gene petal_gaps = (0.4035, 0.6554, 0.3471) in (0.01, 0.01, 0.01)..(1, 1, 1)

let beads = spectrum(bead_1, bead_2 at bead_gaps.x, bead_3 at bead_gaps.x + bead_gaps.y, bead_4 at bead_gaps.x + bead_gaps.y + bead_gaps.z)
let petals = spectrum(petal_1, petal_2 at petal_gaps.x, petal_3 at petal_gaps.x + petal_gaps.y, petal_4 at petal_gaps.x + petal_gaps.y + petal_gaps.z)

shine gloss
sharpness focus
rings
forward lift * open
pitch 90
repeat 5 {
  petal
  yaw 72
}

// Rings of beads round the middle: flat in a disc, or rounded into a ball, as the creature opens.
part rings {
  let radius = max(ball_radius, 1)
  shape ball
  repeat 7 as k {
    let n = k + 1
    colour beads(n / 8)
    // The ring's latitude on the ball, and how many beads fit round it.
    let latitude = 22.5 * n
    let count = floor(2 * pi * n)
    repeat count as b {
      let angle = b * 360 / (2 * pi * n)
      let reach = (1 - open) * n + open * sin(latitude) * radius
      branch {
        move (reach * cos(angle), reach * sin(angle), open * cos(latitude) * radius)
        lay { grow bead_size }
      }
    }
  }
}

part petal {
  branch {
    forward 2.5
    pitch -36
    yaw -45
    roll -30
    shape ball
    repeat 29 as k {
      let swell = bump((k + 1) / 30)
      colour petals(swell)
      yaw 6
      branch {
        forward 0.1
        pitch 90 * swell * curl
        lay { grow (open, open, open * 6 * (swell + 1)) }
      }
      move (0.4 * open, 0, 0)
    }
  }
}

