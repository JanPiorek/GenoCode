creature Starfish
// Four arms, each a wobbling stem of rings ending in a spiral of long petals with a bead at the
// end of each.
// Inspired by Starfish, a DancerDNA creature.

gene swirl = 0 in 0..1 // how much it wears its swirling texture, as the Swirled variant does

gene stem_start = -1.961 in -15..15 // how far from the middle the stems start
gene stride = 0.5112 in -1.5..2 // how far apart the stem's rings are
gene ring_stretch = 3.633 in 2..5 // how long the rings are drawn out along the stem
gene ripples = 3.789 in 2.387..3.979 // how many times the rings swell and shrink along the stem
gene bend = -1.724 in -5.73..5.73 // how far each ring turns sideways from the last
gene wobbles = 1.58 in 0.955..1.91 // how many times the stem wobbles up and down
gene wobble_start = 0.02209 in -0.5..0.5

gene flower_tilt = 35.67 in -114.6..114.6 // how far the flowers tip up from their stems
gene flower_out = 16.37 in 15..35 // how far out the flowers are
gene flower_turn = 12.82 in -57.3..85.94 // how far they turn to the side
gene petals = 11.18 in 4..15 // how many petals
gene petal_length = 8.511 in 4..12
gene petal_rise = 1.944 in -5.73..17.19 // how far each petal tips up from the last
gene petal_turn = 9.983 in -5.73..85.94 // how far each turns sideways from the last
gene bud_out = 7.041 in 4..9 // how far out the beads are

// The rings' colours, from the middle out, and the petals' with the gaps between them.
gene ring_1 = hsv(92.8, 0.66, 0.97) in hsv(0, 0, 0.7)..hsv(360, 1, 1)
gene ring_2 = hsv(239.3, 0.4, 0.38) in hsv(0, 0, 0)..hsv(360, 1, 1)
gene ring_3 = hsv(190.3, 0.71, 0.91) in hsv(0, 0, 0.7)..hsv(360, 1, 1)
gene petal_1 = hsv(283, 0.93, 0.87) in hsv(0, 0, 0)..hsv(360, 1, 1)
gene petal_2 = hsv(244.7, 0.75, 1) in hsv(0, 0.4, 1)..hsv(360, 1, 1)
gene petal_3 = hsv(183, 0.31, 0.24) in hsv(0, 0, 0)..hsv(360, 1, 1)
gene petal_4 = hsv(193.7, 0.76, 1) in hsv(0, 0.4, 1)..hsv(360, 1, 1)
gene petal_gaps = (0.4193, 0.8327, 0.6268) in (0.25, 0.25, 0.25)..(1, 1, 1)

let rings = spectrum(ring_1, ring_2, ring_3)
let blooms = spectrum(petal_1, petal_2 at petal_gaps.x, petal_3 at petal_gaps.x + petal_gaps.y, petal_4 at petal_gaps.x + petal_gaps.y + petal_gaps.z)

shine 1
sharpness 1
texture pattern(vortex, 0, 96, split, iridescent)
wear swirl
pitch -90
// The arms in the original's order: ahead, behind, then to each side.
arm
yaw 180
arm
yaw 90
arm
yaw 180
arm

part arm {
  stem
  branch {
    pitch flower_tilt
    flower
  }
}

part stem {
  branch {
    shape ring
    forward stem_start
    reshape { grow (1, 1, ring_stretch) }
    repeat 30 as k {
      let along = k / 29
      let swell = 1 + wave(ripples * along) / 2
      colour rings(along)
      forward stride
      reshape { grow (swell, swell, 1.05) }
      yaw bend
      pitch degrees(wave(wobbles * along + wobble_start) / 14)
      lay
    }
  }
}

part flower {
  branch {
    shape ball
    forward flower_out
    grow 1.2
    yaw flower_turn
    reshape { grow (1, 1, petal_length) }
    repeat ceil(petals) as k {
      grow 1.05
      pitch petal_rise
      yaw petal_turn
      colour blooms(k / (petals - 1))
      lay
      branch {
        reshape { grow (1, 1, 1 / petal_length) }
        forward bud_out
        lay
      }
    }
  }
}

