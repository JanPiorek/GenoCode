creature Monster
// A many-eyed monster with curling tentacles, sitting on a ring of coral.
// Inspired by Monster, a DancerDNA creature.

gene head_size = 5.51 in 2..8
gene head_colour = hsv(240.5, 1, 0.29) in hsv(0, 1, 0.2)..hsv(252, 1, 0.6)

gene coral_spread = 1.025 in 0.6..2  // how far out the coral reaches
gene coral_up = 0.3082 in 0..5  // how tube-like, rather than round, the coral is above
gene coral_down = 0.3192 in 0..5  // and below
gene coral_spiral = 0.4302 in -1..1  // how far the coral spirals round

gene monster_size = 0.954 in 0.1..2
gene monster_height = 1.585 in -14.73..10.27  // how far above the coral the monster sits
gene monster_turn = (-48.1, -58.75, -34.58) in (-171.9, -171.9, -171.9)..(171.9, 171.9, 171.9)  // how it's turned: up, sideways and round
gene head_turn = (-16.97, -137.1, 165.5) in (-343.8, -343.8, -343.8)..(343.8, 343.8, 343.8)
gene head_stretch = (0.8865, 0.9851, 1.007) in (0.8, 0.8, 0.8)..(1.2, 1.2, 1.2)

gene eye_count = 7.933 in 1..35  // how many eyes; the last is cut short to fit
gene eye_size_waves = 4.726 in 0..8  // how many times the eyes grow and shrink round the head
gene eye_size_spread = 0.1634 in -0.6..0.6
gene eyeball = hsv(89.5, 0.14, 1) in hsv(0, 0, 1)..hsv(360, 0.25, 1)
gene iris = hsv(172.2, 0.87, 0.81) in hsv(0, 0.4, 0.5)..hsv(252, 1, 1)
gene dilation = 0.06402 in 0..1  // how wide the pupils are open
gene slit = 0.5503 in 0..1  // how much taller than wide they are, like a lizard's

gene tentacle_count = 2.692 in 0..4  // how many tentacles; the last is cut short to fit
gene tentacle_waves = 0.8557 in 0..3  // how many times their length changes round the head
gene tentacle_thickness = 0.4537 in 0.1..1
gene tentacle_flatness = 0.6459 in 0.3..0.8
gene tentacle_tip = hsv(132, 0.81, 1) in hsv(0, 0.4, 1)..hsv(360, 1, 1)
gene curl = (16.55, 1.925, 5.863) in (-28.65, -28.65, -28.65)..(28.65, 28.65, 28.65)  // how far the tentacles curl: up, sideways and round
gene curl_waves = (2.472, 2.779, 1.467) in (0.5, 0.5, 0.5)..(4, 4, 4)
gene curl_start = (0.2076, 0.1888, 0.04261) in (-0.5, -0.5, -0.5)..(0.5, 0.5, 0.5)

// The coral's colours, from its tips below to its tips above, and the gaps between them.
gene coral_1 = hsv(269.3, 0.8, 1) in hsv(0, 0.4, 1)..hsv(360, 1, 1)
gene coral_2 = hsv(303.9, 0.84, 1) in hsv(0, 0.4, 1)..hsv(360, 1, 1)
gene coral_3 = hsv(228.6, 0.58, 1) in hsv(0, 0.4, 1)..hsv(360, 1, 1)
gene coral_4 = hsv(189.7, 0.61, 1) in hsv(0, 0.4, 1)..hsv(360, 1, 1)
gene coral_gaps = (0.4955, 0.7982, 0.3412) in (0.25, 0.25, 0.25)..(1, 1, 1)

let coral_colours = spectrum(coral_1, coral_2 at coral_gaps.x, coral_3 at coral_gaps.x + coral_gaps.y, coral_4 at coral_gaps.x + coral_gaps.y + coral_gaps.z)
let tentacle_colours = spectrum(head_colour, tentacle_tip)

sharpness 1
shine 1
pitch 90
coral
monster

// Eight fans of rings round a circle, each curving up and down from the middle.
part coral {
  branch {
    grow 0.3
    shape ring
    let width = 20 * sin(22.5)
    repeat 8 as k {
      branch {
        yaw 45 * k
        segment(1, 0, 0, 0, 10, 0, width)
        fan(1, coral_up, width)
        fan(-1, coral_down, width)
      }
    }
  }
}

part fan(direction, tubeness, start_width) {
  let roundness = 1 - tubeness
  let width = start_width
  let spiral = 0
  let shift = 0
  let reach = 10
  let rise = 0
  repeat 7 as k {
    spiral += coral_spiral * 45
    let shift_by = width / 2 * tubeness
    shift += shift_by
    reach -= shift_by * sin(rise)
    rise += 2 * asin(width / (4 * reach)) * roundness
    width = cos(rise) * 2 * reach * sin(22.5)
    segment(direction, shift, spiral, rise, reach, 0.5 * k / 7, width)
  }
}

part segment(direction, shift, spiral, rise, reach, along, width) {
  branch {
    move (0, -direction * shift, 0)
    yaw direction * spiral
    pitch direction * rise
    forward reach * coral_spread
    roll -90
    colour coral_colours(0.5 + along * direction)
    grow (width, width, 5)
    lay
  }
}

part monster {
  branch {
    grow monster_size
    move (0, monster_height, 0)
    roll monster_turn.z
    yaw monster_turn.y
    pitch monster_turn.x
    head
    eyes
    tentacles
  }
}

part head {
  branch {
    shape ball
    grow head_size
    reshape { roll head_turn.z; yaw head_turn.y; pitch head_turn.x }
    grow head_stretch
    pitch -head_turn.x
    yaw -head_turn.y
    roll -head_turn.z
    colour head_colour
    lay
  }
}

part eyes {
  branch {
    repeat ceil(eye_count) as k {
      let along = k / 34
      roll scatter(1398.73, 1713.58, 1.3424, along)
      yaw scatter(1989.34, 1433.78, 5.9346, along)
      pitch scatter(567.972, 917.12, 0.7753, along)
      let size = 1 + eye_size_spread * sin(180 * eye_size_waves * along)
      // The last eye is cut short.
      if k + 1 > eye_count {
        size *= eye_count % k
      }
      branch {
        forward head_size / 2
        eye(size)
      }
    }
  }
}

part eye(size) {
  let open = 0.2 + dilation * 0.5
  branch {
    shape ball
    grow size
    grow (1, 1, 0.78)
    forward -0.2
    colour eyeball
    lay
    forward 0.455
    texture none
    grow (0.5, 0.5, 0.06)
    colour iris
    lay
    forward 0.5
    grow (open, open + (0.7 - open) * slit, 1)
    forward 0.6
    colour black
    lay
  }
}

part tentacles {
  branch {
    repeat ceil(tentacle_count) as k {
      let along = k / 3
      roll scatter(1597.11, 143.324, 0.7739, along)
      yaw scatter(343.398, 1339.13, 3.916, along)
      pitch scatter(1259.35, 987.997, 1.1193, along)
      let completeness = 0.5 + 0.5 * sin(180 * tentacle_waves * along)
      // The last tentacle is cut short.
      if k + 1 > tentacle_count {
        if k == 0 {
          completeness = 0
        } else {
          completeness *= tentacle_count % k
        }
      }
      branch {
        forward head_size / 2
        tentacle(completeness)
      }
    }
  }
}

// A tentacle that tapers away to nothing, curling as it goes.
part tentacle(completeness) {
  branch {
    let start = completeness * tentacle_thickness * head_size
    grow start
    grow (1, 1, tentacle_flatness)
    shape ball
    let size = start
    while size > 0.01 {
      let along = 1 - (size - 0.01) / (start - 0.01)
      colour tentacle_colours(completeness * along)
      let taper = cos(90 * along) * completeness * 0.99
      lay
      forward 0.4
      grow taper
      roll curl.z * sin(180 * curl_waves.z * (along + curl_start.z))
      pitch curl.x * sin(180 * curl_waves.x * (along + curl_start.x))
      yaw curl.y * sin(180 * curl_waves.y * (along + curl_start.y))
      forward 0.4
      size *= taper
    }
  }
}

// The original's way of scattering eyes and tentacles round the head: turns from very fast
// waves, which look random.
function scatter(waves, size, offset, along) {
  return degrees(sin(degrees(waves * 3.14159 * (along + offset))) * size)
}

