creature Genes
// Two strands, each a ladder of beaded curves, side by side like the strands of DNA.
// Inspired by Genes, a DancerDNA creature.

gene swing = 51.98 in 0..360 // which way the strands point: sideways
gene tilt = 51.92 in 0..360 // and up
gene apart = (10, 9.795, 10) in (10, 0, 0)..(10, 25, 25) // where the second strand is from the first

gene step_1 = (1.202, 0.1621, 0) in (1, 0, 0)..(5, 10, 10) // how far apart the first strand's curves are
gene turn_1 = 0 in 0..51.57 // how far each of its curves turns from the last
gene bend_1 = -38.13 in -179.9..179.9 // how far each bead of a curve bends from the last
gene gap_1 = 1 in 1..10 // how far apart the beads are
gene step_2 = (1.425, 0, 0.1562) in (1, 0, 0)..(5, 10, 10) // the same for the second strand
gene turn_2 = 0 in 0..51.57
gene bend_2 = -1.146 in -179.9..179.9
gene gap_2 = 1.167 in 1..10

// Each strand's colours, from the ends of its curves to the middle, and the gaps between them.
gene first_1 = hsv(111.4, 0.81, 0.88) in hsv(0, 0, 0)..hsv(360, 1, 1)
gene first_2 = hsv(3.3, 0.92, 1) in hsv(0, 0.4, 1)..hsv(360, 1, 1)
gene first_3 = hsv(252, 0.57, 0.85) in hsv(0, 0, 0)..hsv(360, 1, 1)
gene first_4 = hsv(283.1, 0.58, 1) in hsv(0, 0.4, 1)..hsv(360, 1, 1)
gene first_gaps = (0.2977, 0.7326, 0.7914) in (0.25, 0.25, 0.25)..(1, 1, 1)
gene second_1 = hsv(108, 0.5, 1) in hsv(0, 0.4, 1)..hsv(360, 1, 1)
gene second_2 = hsv(144, 0.4, 0.95) in hsv(0, 0.4, 0.93)..hsv(360, 1, 1)
gene second_3 = hsv(180, 0.4, 0) in hsv(0, 0.4, 0)..hsv(360, 1, 1)
gene second_4 = hsv(257, 0.55, 1) in hsv(0, 0.4, 1)..hsv(360, 1, 1)
gene second_gaps = (0.5, 0.6, 0.7323) in (0.01, 0.01, 0.01)..(1, 1, 1)

let first = spectrum(first_1, first_2 at first_gaps.x, first_3 at first_gaps.x + first_gaps.y, first_4 at first_gaps.x + first_gaps.y + first_gaps.z)
let second = spectrum(second_1, second_2 at second_gaps.x, second_3 at second_gaps.x + second_gaps.y, second_4 at second_gaps.x + second_gaps.y + second_gaps.z)

yaw swing
pitch tilt
shape ball
strand(step_1, turn_1, bend_1, gap_1, first)
move apart
strand(step_2, turn_2, bend_2, gap_2, second)

part strand(stride, turn, bend, gap, colours) {
  branch {
    repeat 15 {
      curve(bend, gap, colours)
      pitch turn
      move stride
    }
  }
}

part curve(bend, gap, colours) {
  branch {
    repeat 10 as k {
      pitch bend
      forward gap
      colour colours(bump(k / 20))
      lay
    }
  }
}

