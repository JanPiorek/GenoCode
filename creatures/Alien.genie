creature Alien
// Four curling horns of rings and balls, one in each quarter, each the mirror image of the next.
// Inspired by Alien, a DancerDNA creature.

gene gloss = 0.6674 in 0..1 // how strong the highlights are
gene focus = 0.5846 in 0..1 // how tight the highlights are
gene shape_size = 1.319 in 0.5..2 // how big every ring and ball is
gene shape_turn = (41.42, 41.41, 10.24) in (0, 0, 0)..(57.3, 57.3, 57.3) // how they're turned: up, sideways and round
gene shape_shift = (0.3771, 0.5821, 0.07524) in (0, 0, 0)..(1, 1, 1) // which way they're shifted
gene shift_by = 0.8239 in -1..1 // how far

gene segments = 23.55 in 10..30 // how many segments each horn has; the last is cut short to fit
gene heading = (0.2934, 0.6555, 0.3884) in (0, 0, 0)..(1, 1, 1) // which way each segment leads on from the last
gene stride = -0.9213 in -2..2 // how far
gene taper = 0.7098 in 0.01..2 // how much bigger each segment is than the last
gene curl = 17.53 in 0..28.65 // how far each turns up from the last
gene swerve = 15.04 in 0..28.65 // and sideways

gene strand_offset = (1.432, 0.2977, 0.1456) in (0, 0, 0)..(2, 2, 2) // where a segment's ring and ball are
gene ring_shape = (0.97, 1.011, 0.9497) in (0.8, 0.8, 0.8)..(1.2, 1.2, 1.2)
gene ball_shape = (1.031, 0.8442, 0.9097) in (0.8, 0.8, 0.8)..(1.2, 1.2, 1.2)
gene ball_size = 0.6041 in 0.2..0.9
gene ring_run = 3.86 in 1..8 // how far along their colours the horn's rings go
gene ball_run = 7.825 in 1..8 // and its balls

// The rings' and balls' colours, from the base of a horn out, and the gaps between them.
gene ring_1 = hsv(279.5, 0.84, 0.67) in hsv(0, 0, 0)..hsv(360, 1, 1)
gene ring_2 = hsv(148.7, 0.96, 0.83) in hsv(0, 0, 0)..hsv(360, 1, 1)
gene ring_3 = hsv(294.8, 0.55, 0.31) in hsv(0, 0, 0)..hsv(360, 1, 1)
gene ring_4 = hsv(163.4, 0.49, 0.13) in hsv(0, 0, 0)..hsv(360, 1, 1)
gene ring_gaps = (0.2845, 0.308, 0.2095) in (0.01, 0.01, 0.01)..(1, 1, 1)
gene ball_1 = hsv(261, 0.99, 0.84) in hsv(0, 0, 0)..hsv(360, 1, 1)
gene ball_2 = hsv(189.8, 0.99, 0.95) in hsv(0, 0, 0)..hsv(360, 1, 1)
gene ball_3 = hsv(57.9, 0.32, 0.26) in hsv(0, 0, 0)..hsv(360, 1, 1)
gene ball_4 = hsv(125.9, 0.67, 0.57) in hsv(0, 0, 0)..hsv(360, 1, 1)
gene ball_gaps = (0.6716, 0.5044, 0.4505) in (0.01, 0.01, 0.01)..(1, 1, 1)

// Each band of colours is stretched to end where the original's did: at its first colour at
// or beyond 1.
let ring_end = band_end(ring_gaps)
let ball_end = band_end(ball_gaps)
let rings = spectrum(ring_1, ring_2 at ring_gaps.x / ring_end, ring_3 at (ring_gaps.x + ring_gaps.y) / ring_end, ring_4 at (ring_gaps.x + ring_gaps.y + ring_gaps.z) / ring_end)
let balls = spectrum(ball_1, ball_2 at ball_gaps.x / ball_end, ball_3 at (ball_gaps.x + ball_gaps.y) / ball_end, ball_4 at (ball_gaps.x + ball_gaps.y + ball_gaps.z) / ball_end)

shine gloss
sharpness focus
reshape {
  grow shape_size
  pitch shape_turn.x
  roll shape_turn.z
  yaw shape_turn.y
  move normalize(shape_shift) * shift_by
}
symmetric x {
  symmetric y {
    horn
  }
}

part horn {
  branch {
    repeat floor(segments) as k {
      segment(k / segments)
    }
    // The last segment is cut short by what's left of the count.
    if frac(segments) > 0 {
      grow frac(segments)
      segment(1)
    }
  }
}

part segment(along) {
  branch {
    move strand_offset
    branch {
      colour rings(along * ring_run / ring_end)
      shape ring
      lay { grow ring_shape }
    }
    colour balls(along * ball_run / ball_end)
    shape ball
    grow ball_size
    lay { grow ball_shape }
  }
  move normalize(heading) * stride
  pitch curl
  yaw swerve
  grow taper
}

// Where a band's colours end: the original added colours until one reached 1, so later ones
// are never seen.
function band_end(gaps) {
  let end = gaps.x
  if end < 1 {
    end += gaps.y
  }
  if end < 1 {
    end += gaps.z
  }
  return end
}

