creature FlyingFish
// Three fish swimming in a triangle, with fins, eyes and tails, each chasing a fly.
// Inspired by FlyingFish, a DancerDNA creature.

gene apart  = 32.1   in -20..40                                           // how far apart the fish are
gene fly_at = (2.239, 4.799, -3.661) in (-10, -15, -12.13)..(10, 15, 10)  // where each fly is from its fish
gene stray  = 0.2733 in -17..10                                           // how far the third fish strays up or down

gene head_shape = ball   from [ball, ring]
gene dive       = -8.008 in -65.41..65.41  // how far the fish tip their heads down
gene bank       = 0      in -114.6..114.6  // how far they roll
gene stride     = 0.6983 in 0.2..1         // how far apart the body's segments are
gene thickness  = 1.008  in 1..1.1         // how much longer each segment is than the last
gene flap       = 1.166  in 0..2           // where the body is in its beat, which bends it
gene swim       = -80.53 in -180..180      // where the segments' spacing starts its wave

gene fin_size   = -0.05533 in -1..1          // how big the side fins are; never less than 0.2
gene fin_length = 7.154    in 7..11          // how many beads each fin has
gene fin_tilt   = 33.67    in -57.3..57.3
gene fin_curl   = 1.657    in -22.92..28.65  // how far each bead of a fin turns from the last: up
gene fin_sweep  = 6.333    in -5.73..28.65   // and sideways

gene fly_length = 8.915  in 5..15  // how many cones the fly has
gene fly_size   = 0.2073 in 0.2..1.2
gene fly_curl   = 12.83  in -22.92..28.65
gene fly_sweep  = 16.2   in -5.73..85.95

// The colours of the body, from head to tail, of the fins and of the flies.
gene body_1 = hsv(333.7, 1, 0.92) in hsv(0, 0, 0.7)..hsv(360, 1, 1)
gene body_2 = hsv(309.1, 0.72, 0.88) in hsv(0, 0, 0.3)..hsv(360, 1, 1)
gene body_3 = hsv(129.4, 0.85, 0.93) in hsv(0, 0, 0.7)..hsv(360, 1, 1)
gene fin_1  = hsv(138.1, 0.79, 0.88) in hsv(0, 0, 0.7)..hsv(360, 1, 1)
gene fin_2  = hsv(252, 1, 1) in hsv(0, 0, 0.3)..hsv(360, 1, 1)
gene fin_3  = hsv(350.3, 0.71, 0.9) in hsv(0, 0, 0.7)..hsv(360, 1, 1)
gene fly_1  = hsv(154.8, 0.9, 0.99) in hsv(0, 0, 0.7)..hsv(360, 1, 1)
gene fly_2  = hsv(356.4, 0.81, 0.82) in hsv(0, 0, 0.3)..hsv(360, 1, 1)
gene fly_3  = hsv(204.4, 0.9, 0.99) in hsv(0, 0, 0.7)..hsv(360, 1, 1)

let body = spectrum(body_1, body_2, body_3)
let fins = spectrum(fin_1, fin_2, fin_3)
let flies = spectrum(fly_1, fly_2, fly_3)

pitch 90
repeat 3 as k {
  if k > 0 {
    yaw 60
    forward apart
    yaw 60
  }
  if k == 2 {
    move (0, stray, 0)
  }
  fish
  if k == 2 {
    move (0, -stray, 0)
  }
  branch {
    move fly_at
    fly
  }
}

part fish {
  branch {
    pitch dive
    roll bank
    shape head_shape
    lay
    forward stride / 2
    reshape { grow (1, 1, 2) }
    repeat 26 as k {
      let along = k / 25
      let swell = 1 + sin(degrees(along * 10)) / 2.2
      yaw degrees(0.07) * wave(flap)
      reshape { grow (swell * 0.93, swell, thickness) }
      colour body(along)
      lay
      if k == 9 {
        branch {
          yaw -90
          symmetric z {
            fin
          }
        }
      }
      if k == 5 {
        symmetric x {
          eye
        }
      }
      if k == 12 {
        symmetric y {
          tail
        }
      }
      forward stride * sin(30 * k + swim) + 1
    }
  }
}

part fin {
  branch {
    grow max(fin_size, 0.2)
    roll 90
    move (0, 0, 4)
    shape ball
    reshape { grow (1, 1, 6); forward 0.5 }
    pitch fin_tilt
    repeat ceil(fin_length) as k {
      pitch fin_curl
      yaw fin_sweep
      grow (1, 1, 0.9)
      colour fins(k / (fin_length - 1))
      lay
    }
  }
}

part tail {
  branch {
    grow 0.5
    move (0, 3, 0)
    shape cone
    grow (0.5, 1, 1)
    pitch -80.2
    forward 3
    lay
  }
}

part eye {
  branch {
    shape ring
    colour hsv(108, 0.5, 1)
    move (1.5, 1, 0)
    grow 0.5
    lay
    colour red
    shape ball
    grow 0.7
    lay
  }
}

part fly {
  branch {
    reshape { grow (1, 1, 5); forward 0.5 }
    grow fly_size
    shape cone
    repeat ceil(fly_length) as k {
      pitch fly_curl
      yaw fly_sweep
      reshape { grow (1, 1, 1.1) }
      colour flies(k / (fly_length - 1))
      lay
    }
  }
}

