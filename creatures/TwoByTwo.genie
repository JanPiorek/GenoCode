creature TwoByTwo
// A ball with two arms of petals, buds and beads curling away from it, one the mirror image of
// the other.
// Inspired by 2by2, a DancerDNA creature.

gene ball_stretch = 0.1725 in -0.33..13.68                                       // how long the ball is drawn out
gene arm_start    = 0.7768 in 0.09..11.27                                        // how far from the ball the arms start
gene arm_1_length = 48.32  in 2..50                                              // how many petals each arm has; the last is cut short to fit
gene arm_2_length = 20.11  in 2..50
gene first_offset = (-6.349, -2.84, -2.804) in (-44.35, -15, -15)..(15, 15, 15)  // where the arms' second petal is from the first
gene splay        = -16.57 in -40.11..40.11                                      // how far each petal turns out to the side
gene lean         = -15.12 in -50..50                                            // how far each petal tips up
gene petal_tip    = -1.711 in -50..50                                            // how far it tips again, towards its bud
gene petal_length = 5.908  in -0.33..13.68
gene bud_out      = 3.096  in -4..4.09                                           // how far out along the petal its bud is
gene bead_out     = -4     in -13.38..4.09                                       // how far out its bead is
gene taper        = 0.9457 in 0.9..1.1                                           // how much bigger each petal is than the last
gene curl         = 19.37  in -50..50                                            // how far each petal turns from the last
gene colour_run   = 2.708  in 1..3                                               // how far along its colours each arm goes

// The petals', buds' and beads' colours, from the ball out, and the gaps between them.
gene petal_1    = hsv(48, 0.6, 1) in hsv(0, 0.4, 1)..hsv(360, 1, 1)
gene petal_2    = hsv(355.2, 0.75, 1) in hsv(0, 0.4, 1)..hsv(360, 1, 1)
gene petal_3    = hsv(81.6, 0.63, 1) in hsv(0, 0.4, 1)..hsv(360, 1, 1)
gene petal_4    = hsv(35.9, 0.54, 1) in hsv(0, 0.4, 1)..hsv(360, 1, 1)
gene petal_gaps = (0.4494, 0.8102, 0.5531) in (0.25, 0.25, 0.25)..(1, 1, 1)
gene bud_1      = hsv(211.9, 0.55, 1) in hsv(0, 0.4, 1)..hsv(360, 1, 1)
gene bud_2      = hsv(347.1, 0.53, 1) in hsv(0, 0.4, 1)..hsv(360, 1, 1)
gene bud_3      = hsv(259.7, 0.73, 1) in hsv(0, 0.4, 1)..hsv(360, 1, 1)
gene bud_4      = hsv(288.2, 0.52, 1) in hsv(0, 0.4, 1)..hsv(360, 1, 1)
gene bud_gaps   = (0.8816, 0.6087, 0.9347) in (0.25, 0.25, 0.25)..(1, 1, 1)
gene bead_1     = hsv(28.6, 0.74, 0.12) in hsv(0, 0, 0)..hsv(360, 1, 1)
gene bead_2     = hsv(247.1, 0.65, 0.83) in hsv(0, 0, 0)..hsv(360, 1, 1)
gene bead_3     = hsv(150, 0.59, 0.23) in hsv(0, 0, 0)..hsv(360, 1, 1)
gene bead_4     = hsv(260.4, 0.97, 1) in hsv(0, 0, 0)..hsv(360, 1, 1)
gene bead_gaps  = (0.6324, 0.8043, 0.9976) in (0.25, 0.25, 0.25)..(1, 1, 1)

// Each band of colours is stretched to end where the original's did: at its first colour at
// or beyond 1.
let petal_end = band_end(petal_gaps)
let bud_end = band_end(bud_gaps)
let bead_end = band_end(bead_gaps)
let petals = spectrum(petal_1, petal_2 at petal_gaps.x / petal_end, petal_3 at (petal_gaps.x + petal_gaps.y) / petal_end, petal_4 at (petal_gaps.x + petal_gaps.y + petal_gaps.z) / petal_end)
let buds = spectrum(bud_1, bud_2 at bud_gaps.x / bud_end, bud_3 at (bud_gaps.x + bud_gaps.y) / bud_end, bud_4 at (bud_gaps.x + bud_gaps.y + bud_gaps.z) / bud_end)
let beads = spectrum(bead_1, bead_2 at bead_gaps.x / bead_end, bead_3 at (bead_gaps.x + bead_gaps.y) / bead_end, bead_4 at (bead_gaps.x + bead_gaps.y + bead_gaps.z) / bead_end)

colour petals(0.51 / petal_end)
pitch -90
roll 40.107
yaw 40.107
branch {
  shape ball
  lay { grow (1, 1, ball_stretch) }
  forward arm_start
  branch {
    arm(arm_1_length)
  }
  branch {
    mirror x
    arm(arm_2_length)
  }
}

part arm(count) {
  shape ball
  repeat floor(count) + 2 as k {
    let along = k / count * colour_run
    // The last petal is cut short by what's left of the count.
    let size = 1
    if k > count {
      size = count % 1
    }
    branch {
      yaw splay
      pitch lean
      branch {
        pitch petal_tip
        colour petals(along / petal_end)
        lay { grow (1, 1, petal_length) * size }
        forward bud_out
        colour buds(along / bud_end)
        lay { grow size }
      }
      forward bead_out
      colour beads(along / bead_end)
      lay { grow size }
    }
    if k == 0 {
      move first_offset
    }
    grow taper
    pitch curl
  }
}

// Where a band's colours end: the original added colours until one reached 1, so later ones
// are never seen.
function band_end(gaps) {
  let end = gaps.x
  if end < 1 {
    end += gaps.y
  }
  if end < 1 {
    end += gaps.z
  }
  return end
}

