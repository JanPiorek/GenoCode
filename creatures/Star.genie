creature Star
// Five arms of interlocking rings, like chains, bending and swelling as they reach out.
// Inspired by Star, a DancerDNA creature.

gene twist       = -29.76 in -45.84..45.84  // how far the arms twist
gene twist_waves = 1.731  in 0.5..4         // how many half-waves the twist makes along an arm
gene twist_start = 0.2835 in -1..1          // where along the arm the twist starts
gene rise        = -22.87 in -45.84..45.84  // how far the arms bend up and down
gene rise_waves  = 3.569  in 0.5..4
gene rise_start  = 0.7635 in -1..1
gene sway        = -7.982 in -45.84..45.84  // how far the arms bend from side to side
gene sway_waves  = 2.758  in 0.5..4
gene sway_start  = 0.7958 in -1..1

gene swell       = (0.2831, 0.1906, -0.1473) in (-0.4, -0.4, -0.4)..(0.4, 0.4, 0.4)  // how much the links grow and shrink: across, up and along
gene swell_waves = (4.965, 17.21, 1.795) in (0, 0, 0)..(20, 20, 20)                  // how many half-waves the swelling makes along an arm
gene swell_start = (0.1605, -0.7255, -0.9763) in (-1, -1, -1)..(1, 1, 1)

// The colours of the links lying flat and of those standing upright, from the middle out, and
// the gaps between them.
gene flat_1    = hsv(334, 0.93, 0.02) in hsv(0, 0, 0)..hsv(360, 1, 1)
gene flat_2    = hsv(145.2, 0.47, 0.01) in hsv(0, 0, 0)..hsv(360, 1, 1)
gene flat_3    = hsv(96, 0.99, 0.77) in hsv(0, 0, 0)..hsv(360, 1, 1)
gene flat_4    = hsv(44.5, 0.47, 0.84) in hsv(0, 0, 0)..hsv(360, 1, 1)
gene flat_gaps = (0.9819, 0.3743, 0.495) in (0.25, 0.25, 0.25)..(1, 1, 1)

gene upright_1    = hsv(198, 0.7, 1) in hsv(0, 0.4, 1)..hsv(360, 1, 1)
gene upright_2    = hsv(56.7, 0.88, 1) in hsv(0, 0.4, 1)..hsv(360, 1, 1)
gene upright_3    = hsv(114.2, 0.9, 1) in hsv(0, 0.4, 1)..hsv(360, 1, 1)
gene upright_4    = hsv(319.8, 0.41, 1) in hsv(0, 0.4, 1)..hsv(360, 1, 1)
gene upright_gaps = (0.2962, 0.3338, 0.4979) in (0.25, 0.25, 0.25)..(1, 1, 1)

let flat = spectrum(flat_1, flat_2 at flat_gaps.x, flat_3 at flat_gaps.x + flat_gaps.y, flat_4 at flat_gaps.x + flat_gaps.y + flat_gaps.z)
let upright = spectrum(upright_1, upright_2 at upright_gaps.x, upright_3 at upright_gaps.x + upright_gaps.y, upright_4 at upright_gaps.x + upright_gaps.y + upright_gaps.z)

shine 1
sharpness 1
repeat 5 as arm {
  branch {
    chain(arm)
  }
  roll 72
}

part chain(arm) {
  shape ring
  repeat 20 as k {
    let along = k / 20
    // Every other link stands upright. The first arm leaves out its first link, which would
    // overlap the others' in the middle.
    if arm > 0 or k > 0 {
      branch {
        if k % 2 == 0 {
          colour flat(along)
        } else {
          colour upright(along)
          yaw 90
        }
        lay
      }
    }
    move (0, 0.25, 0)
    roll twist * sin(180 * twist_waves * (along + twist_start))
    pitch rise * sin(180 * rise_waves * (along + rise_start))
    yaw sway * sin(180 * sway_waves * (along + sway_start))
    grow (1 + swell.x * sin(180 * swell_waves.x * (along + swell_start.x)), 1 + swell.y * sin(180 * swell_waves.y * (along + swell_start.y)), 1 + swell.z * sin(180 * swell_waves.z * (along + swell_start.z)))
    move (0, 0.25, 0)
  }
}

