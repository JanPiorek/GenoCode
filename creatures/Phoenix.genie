creature Phoenix
// Two wings of long, glowing feathers, fanned out side by side, each feather a little longer or
// shorter than the last.
// Inspired by Phoenix, a DancerDNA creature.

gene feather = 26      in 3..30        // how long the feathers are
gene fan     = 15.99   in -17.2..17.2  // how far each feather turns sideways from the last
gene lift    = 0       in -17.2..17.2  // how far each feather tips up or down from the last
gene twist   = 5.73    in -17.2..17.2  // how far each feather rolls from the last
gene spacing = 0.04056 in -0.1..0.1    // how far apart the feathers' roots are

gene ripples = 0.2214  in 0..4       // how many times the feathers swell and shrink along a wing
gene ripple  = -0.164  in -0.2..0.2  // how much longer or shorter each feather is than the last
gene start   = -0.2569 in -1..1      // where along the wing the swelling starts

// The plumage, from the first feather to the last.
gene first       = hsv(242.1, 0.97, 0.71) in hsv(0, 0, 0)..hsv(360, 1, 1)
gene second      = hsv(3.3, 0.92, 1) in hsv(0, 0.4, 1)..hsv(360, 1, 1)
gene third       = hsv(345.5, 0.62, 0.14) in hsv(0, 0, 0)..hsv(360, 1, 1)
gene last        = hsv(200.2, 0.4, 1) in hsv(0, 0.4, 1)..hsv(360, 1, 1)
gene second_at   = 0.6051 in 0.25..1  // where the second colour is
gene third_after = 0.8738 in 0.25..1  // how far after the second the third is
gene last_after  = 0.5588 in 0.25..1  // how far after the third the last is

let plumage = spectrum(first, second at second_at, third at second_at + third_after, last at second_at + third_after + last_after)

symmetric x {
  wing
}

part wing {
  shape ball
  grow (1, 1, feather)
  repeat 20 as i {
    let along = i / 19
    colour plumage(along)
    lay
    yaw fan
    pitch lift
    roll twist
    forward spacing
    grow (1, 1, 1 + ripple * sin(180 * ripples * (along + start)))
  }
}

