creature Psybat
// A bat with striped wings, each wing a fan of 27 ribs, each rib a long vane ending in a bead,
// with a bone of beads beside it.
// Inspired by Psybat, a DancerDNA creature.

gene shoulder = 7.692 in -40..60 // how far from the middle each wing starts
gene spread = 23.93 in -171.9..171.9 // how far the wings turn out to the sides
gene vane_tilt = 43.04 in -45..45 // how far each rib tips up from the wing
gene vane_dip = -13.09 in -45..45 // how far its vane tips back down
gene vane_long = 7.706 in 1..11 // how long the vanes are
gene vane_out = -0.9186 in -14..14 // how far out along the vane its bead is
gene bone_grow = 1.038 in 1.01..1.1 // how much bigger the bone's bead is than the vane
gene bone_roll = 5.653 in -25..25 // how far the bone turns round from the vane
gene bone_out = -5.682 in -14..14 // how far out the bone's bead is
gene rib_gap = 0.1545 in -0.5..0.5 // how far apart the ribs are
gene rib_grow = 1.035 in 1.01..1.1 // how much bigger each rib is than the last
gene rib_roll = -17.97 in -25..25 // how far each rib turns round from the last

// Each part's two colours, which alternate in stripes across the wing, and how wide the
// stripes are.
gene vane_1 = hsv(35.2, 0.69, 0.82) in hsv(0, 0.4, 0.76)..hsv(237.6, 1, 1)
gene vane_2 = hsv(127.9, 0.6, 0.8) in hsv(0, 0.4, 0.44)..hsv(237.6, 1, 1)
gene vane_width_1 = 0.2256 in 0.05..0.3
gene vane_width_2 = 0.1792 in 0.05..0.3
gene tip_1 = hsv(266.1, 1, 1) in hsv(0, 0.77, 0.47)..hsv(360, 1, 1)
gene tip_2 = hsv(36.7, 1, 1) in hsv(0, 0.48, 0.87)..hsv(360, 1, 1)
gene tip_width_1 = 0.2484 in 0.05..0.3
gene tip_width_2 = 0.2001 in 0.05..0.3
gene bone_1 = hsv(42.2, 1, 1) in hsv(0, 1, 1)..hsv(176.4, 1, 1)
gene bone_2 = hsv(2.9, 1, 1) in hsv(0, 1, 1)..hsv(176.4, 1, 1)
gene bone_width_1 = 0.1182 in 0.05..0.3
gene bone_width_2 = 0.07559 in 0.05..0.3

shine 1
sharpness 1
shape ball
symmetric x {
  wing
}

part wing {
  branch {
    move (shoulder, 0, 0)
    yaw spread
    repeat 27 as k {
      let across = k / 27
      branch {
        pitch vane_tilt
        branch {
          pitch vane_dip
          colour stripes(across, vane_1, vane_2, vane_width_1, vane_width_2)
          lay { grow (1, 1, vane_long) }
          forward vane_out
          pitch -90
          colour stripes(across, tip_1, tip_2, tip_width_1, tip_width_2)
          lay
        }
        grow bone_grow
        roll bone_roll
        forward bone_out
        pitch -90
        colour stripes(across, bone_1, bone_2, bone_width_1, bone_width_2)
        lay
      }
      forward -rib_gap
      grow rib_grow
      roll rib_roll
    }
  }
}

// Two colours in stripes at `t`: blending from `a` to `b` over `a_width`, back to `a` over
// `b_width`, and so on, for up to 16 blends, until the stripes reach 1. Hue blends in a straight
// line, as in a spectrum.
function stripes(t, a, b, a_width, b_width) {
  let edge = 0
  repeat 8 {
    if t <= edge + a_width {
      return spectrum(a, b)((t - edge) / a_width)
    }
    edge += a_width
    if edge >= 1 {
      return b
    }
    if t <= edge + b_width {
      return spectrum(b, a)((t - edge) / b_width)
    }
    edge += b_width
    if edge >= 1 {
      return a
    }
  }
  return a
}

