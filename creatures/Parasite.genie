creature Parasite
// A segmented worm with a pair of legs on every segment, which can curl up into a ring with its
// legs splayed out.
// Inspired by Parasite, a DancerDNA creature.

gene legs_away = -3.683 in -5..1  // how far the legs stand off from the body; at 0 or below they're attached
gene curl_up   = -1.923 in -5..2  // how far the body curls into a ring: 0 not at all, 1 all the way
gene leg_reach = 4.18   in 1..30  // how far off the legs are when they stand off

gene stride       = 0.9559  in 0.8..1.05                                                       // how long the body's segments are
gene wiggle       = (-2.755, 10.34, -1.77) in (-17.19, -17.19, -17.19)..(17.19, 17.85, 17.19)  // how far the body wiggles: up, sideways and round
gene wiggle_waves = (2.65, 2.298, 2.554) in (1, 1, 1)..(3, 3, 3)                               // how many half-waves the wiggles make along it
gene swell        = 0.02704 in -0.15..0.15                                                     // how much the segments grow and shrink
gene swell_waves  = 0.7213  in 0.1..4

gene leg_length     = 11.54   in 0..15        // how many beads the longest legs have
gene leg_waves      = 1.912   in 0.5..10      // how many times the legs grow and shrink along the body
gene leg_start      = 0.668   in 0..1
gene leg_turn       = -0.1754 in -57.3..57.3  // how far the legs turn as the body curls up
gene leg_spread     = 0.9165  in 0..3         // how far apart the beads of the inner legs are as it curls up
gene bead_length    = 1.829   in 0.2..3
gene bead_taper     = 0.9351  in 0.8..1.1     // how much bigger each bead is than the last
gene leg_curl       = 1.092   in -1.5..1.5
gene leg_curl_waves = 1.349   in 0.5..4

// The body's colours, from head to tail, and the gaps between them; and the legs' tips.
gene body_1    = hsv(72.7, 0.83, 1) in hsv(0, 0.4, 1)..hsv(360, 1, 1)
gene body_2    = hsv(70.9, 0.89, 1) in hsv(0, 0.4, 1)..hsv(360, 1, 1)
gene body_3    = hsv(49.8, 0.81, 1) in hsv(0, 0.4, 1)..hsv(360, 1, 1)
gene body_4    = hsv(79.9, 0.65, 1) in hsv(0, 0.4, 1)..hsv(360, 1, 1)
gene body_gaps = (0.5113, 0.4083, 0.5948) in (0.25, 0.25, 0.25)..(1, 1, 1)
gene leg_tip   = hsv(219.4, 0.51, 1) in hsv(0, 0.4, 1)..hsv(360, 1, 1)

let body = spectrum(body_1, body_2 at body_gaps.x, body_3 at body_gaps.x + body_gaps.y, body_4 at body_gaps.x + body_gaps.y + body_gaps.z)

let away = max(legs_away, 0)
let attached = 1 - away
let circle = clamp(curl_up, 0, 1)
let loose = (1 - circle) * attached

yaw 90
sharpness 1
shine 1
worm

part worm {
  branch {
    shape donut
    colour body(0)
    lay
    forward -0.3
    shape tube
    repeat 30 as k {
      let along = k / 30
      forward stride / 2
      yaw loose * wiggle.y * sin(180 * wiggle_waves.y * along)
      pitch 12 * circle + loose * wiggle.x * sin(180 * wiggle_waves.x * along)
      roll loose * wiggle.z * sin(180 * wiggle_waves.z * (along - 1))
      grow 1 + loose * swell * sin(180 * swell_waves * along)
      forward stride / 2
      colour body(along)
      lay
      branch {
        let beads = leg_length * sin(180 * leg_waves * (along + leg_start))
        leg(beads, body(along), stride_out(true))
        mirror y
        leg(beads, body(along), stride_out(false))
      }
    }
    forward stride - 0.4
    shape donut
    lay
  }
}

// How far apart a leg's beads are: the inner legs spread as the body curls up.
function stride_out(inner) {
  if inner {
    return 0.4 + circle * leg_spread
  }
  return 0.4
}

part leg(beads, base, spacing) {
  branch {
    pitch 90
    yaw circle * attached * leg_turn
    forward away * leg_reach
    shape ball
    grow (0.5, 0.5, bead_length)
    forward -0.2
    let size = bead_taper
    repeat ceil(beads) as k {
      forward spacing
      let along = k / beads
      colour spectrum(base, leg_tip)(along)
      // The last bead is cut short by what's left of the count.
      if k + 1 > beads {
        size *= beads % 1
      }
      grow size
      yaw degrees(attached * (leg_curl * sin(180 * leg_curl_waves * along)) ^ 3)
      forward spacing
      lay
    }
  }
}

