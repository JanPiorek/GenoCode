creature Neuron
// A nerve cell: a body with three branching trees of wiggling dendrites, inside two mirrored
// loops of field lines.
// Inspired by Neuron, a DancerDNA creature.

gene turn = (-77.86, 18.88, -140.4) in (-229.2, -229.2, -229.2)..(229.2, 229.2, 229.2) // how the cell is turned: up, sideways and round
gene body_size = 2.929 in 2..7
gene turn_2 = (-86.24, 173.8, -168.6) in (-343.8, -343.8, -343.8)..(343.8, 343.8, 343.8) // how the second tree turns from the first
gene turn_3 = (204.1, 343.5, -101.1) in (-343.8, -343.8, -343.8)..(343.8, 343.8, 343.8) // and the third from the second

gene knot_size = 1.588 in 1.5..4 // how big the knots where the trees fork are
gene branch_scale = 1.068 in 0.8..3 // how big the smaller branches are, times three
gene fork = 53.76 in -114.6..114.6 // how far the smaller branches tip out

gene dendrite_length = 10.6 in 0..14 // how many segments each dendrite has; the last is cut short to fit
gene stride = 1.088 in 0.9..1.2
gene wiggle = (21.93, 8.185, 3.105) in (-22.92, -22.92, -22.92)..(22.92, 22.92, 22.92) // how far a dendrite wiggles: up, sideways and round
gene wiggle_waves = (1.181, 1.006, 1.707) in (1, 1, 1)..(3, 3, 3)
gene swell = 0.02547 in -0.16..0.16 // how much its segments grow and shrink
gene swell_waves = 1 in 0.1..4

gene field_size = 0.4969 in 0.2..2
gene field_shift = (-0.1875, 0.1901, 0.3583) in (-0.5, -0.5, -0.5)..(0.5, 0.5, 0.5)
gene loop_tilt = 18.45 in -171.9..171.9 // how far the field lines swing out
gene loop_waves = 1 in 1..15
gene loop_start = 0.02981 in 0..1
gene loop_swing = -60.11 in -171.9..171.9 // how far they swing round
gene loop_swing_waves = 1.825 in 1..15
gene loop_swing_start = 0.4572 in 0..1

// The cell's colours, from its middle out, and the gaps between them; and the field lines', all
// one hue, from dark to light.
gene nerve_1 = hsv(237.6, 1, 1) in hsv(0, 1, 1)..hsv(360, 1, 1)
gene nerve_2 = hsv(24.1, 0.82, 1) in hsv(0, 0.4, 1)..hsv(360, 1, 1)
gene nerve_3 = hsv(19.7, 0.81, 1) in hsv(0, 0.4, 1)..hsv(360, 1, 1)
gene nerve_gap_1 = 0.5903 in 0.333..1.5
gene nerve_gap_2 = 0.3354 in 0.333..1.5
gene field_hue = 257.7 in 0..360
gene field_shade = (0.1397, 0.01734, 0.08495) in (0, 0, 0)..(1, 1, 1) // how bright the field lines are at their ends, and further in
gene field_light = 0.6858 in 0..1 // how bright they are in the middle
gene field_gaps = (0.3759, 0.5049, 0.3476) in (0.25, 0.25, 0.25)..(1, 1, 1)

let nerve = spectrum(nerve_1, nerve_2 at nerve_gap_1, nerve_3 at nerve_gap_1 + nerve_gap_2)
let field_colours = spectrum(hsv(field_hue, 1, field_shade.x), hsv(field_hue, 1, field_shade.y) at field_gaps.x, hsv(field_hue, 1, field_shade.z) at field_gaps.x + field_gaps.y, hsv(field_hue, 1, field_light) at field_gaps.x + field_gaps.y + field_gaps.z)

cell
grow field_size * 40
move field_shift
symmetric y {
  field
}

part cell {
  branch {
    roll turn.z
    yaw turn.y
    pitch turn.x
    shine 1
    sharpness 1
    blob(body_size)
    shape tube
    limb(2, body_size / 2)
    yaw turn_2.y
    pitch turn_2.x
    roll turn_2.z
    limb(2, body_size / 2)
    yaw turn_3.y
    pitch turn_3.x
    roll turn_3.z
    limb(2, body_size / 2)
  }
}

// A dendrite with a knot at its end, forking into three smaller limbs until `depth` runs out.
part limb(depth, reach) {
  branch {
    forward reach
    dendrite
    forward knot_size / 2
    blob(knot_size)
    if depth > 1 {
      let scale = branch_scale / 3
      grow scale
      repeat 3 as k {
        branch {
          roll 120 * k
          pitch fork
          limb(depth - 1, knot_size / (2 * scale))
        }
      }
    }
  }
}

part blob(size) {
  colour nerve(0)
  branch {
    shape ball
    lay { grow size }
  }
}

part dendrite {
  let rest = dendrite_length % 1
  colour nerve(0)
  forward stride / 2
  repeat ceil(dendrite_length) as k {
    lay
    if k < dendrite_length - 1 {
      let along = k / (dendrite_length - 1)
      forward stride / 2
      yaw wiggle.y * sin(180 * wiggle_waves.y * along)
      pitch wiggle.x * sin(180 * wiggle_waves.x * along)
      roll wiggle.z * sin(180 * wiggle_waves.z * along)
      grow 1 + swell * sin(180 * swell_waves * along)
      forward stride / 2
      colour nerve(1 - abs(1 - 2 * ((k + 1) / dendrite_length)))
    }
  }
  // The last segment is cut short by what's left of the length.
  if rest > 0 {
    forward stride / 2
    yaw wiggle.y * sin(180 * wiggle_waves.y)
    pitch wiggle.x * sin(180 * wiggle_waves.x)
    roll wiggle.z * sin(180 * wiggle_waves.z)
    grow 1 + swell * sin(180 * swell_waves)
    grow (1, 1, rest)
    forward stride / 2
    colour nerve(0)
    lay
    forward stride / 2
    grow (1, 1, 1 / rest)
  } else {
    forward stride / 2
  }
}

// A loop of field lines round the cell.
part field {
  branch {
    sharpness 0
    shine 0
    let first = (0, 1, 0)
    let previous = first
    repeat 20 as k {
      let along = k / 19
      let tilt = loop_tilt * sin(180 * loop_waves * (along - loop_start))
      let swing = loop_swing * sin(180 * loop_swing_waves * (along - loop_swing_start))
      let next = (sin(tilt) * cos(swing), cos(tilt), sin(tilt) * sin(swing))
      colour field_colours(1 - abs(1 - 2 * along))
      line(previous, next)
      previous = next
    }
    line(previous, first)
  }
}

// A thin line from `a` to `b`.
part line(a, b) {
  let d = b - a
  branch {
    move a
    yaw atan2(d.x, d.z)
    pitch -atan2(d.y, length((d.x, 0, d.z)))
    forward length(d) / 2
    grow (0.01, 0.01, length(d))
    lay
  }
}

