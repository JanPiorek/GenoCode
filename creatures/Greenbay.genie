creature Greenbay
// A frond of leaves and buds, curling and growing segment by segment.
// Inspired by Greenbay, a DancerDNA creature.

gene tilt = 106 in 45..135 // how far the frond tips up
gene segments = 20.72 in 1..50 // how many segments it has; the last is cut short to fit
gene growth = (1.074, 1.027, 1.031) in (1.01, 1.01, 1.01)..(1.1, 1.1, 1.1) // how much bigger each segment is than the last
gene twist = 22.7 in -25..25 // how far each segment rolls from the last

gene lean = 86.11 in -114.6..114.6 // how far a segment's leaves lean from it
gene leaf_angle = 58.42 in 45..135 // how far the first leaf tips out
gene leaf_shape = (0.3589, 1.048, 6.502) in (0.2, 0.8, -0.33)..(1.1, 1.1, 13.68) // its width, thickness and length
gene stalk = 2.825 in 0.09..4.1 // how far out the first bud is
gene leaf_twist = -728.3 in -1718.9..1718.9 // how far the second leaf rolls from the first
gene leaf_turn = -15.67 in -25..25
gene second_leaf = 0.169 in -0.33..13.68 // how long the second leaf is
gene offset = 3.702 in -0.33..13.68 // how far along the segment its other leaves are
gene bud_tilt = -95.8 in -286.5..286.5 // how far the middle bud tips
gene bud_turn = 3.461 in -4..4
gene bud_stretch = 3.797 in -0.33..13.68 // how long the middle bud and the leaf beyond it are drawn out
gene far_angle = 113.3 in 45..135 // how far the far leaf tips out
gene far_leaf = -0.0222 in -0.33..13.68 // how long the far leaf is
gene far_stalk = 1.25 in 0.09..4.1 // how far out the far bud is
gene spine = 11.76 in -0.33..13.68 // how far along the segment its last leaf is

// The buds' and leaves' colours, from the first segment to the last, and the gaps between them.
gene bud_1 = hsv(99.9, 0.94, 1) in hsv(14.4, 0.5, 1)..hsv(237.6, 1, 1)
gene bud_2 = hsv(153, 0.65, 1) in hsv(14.4, 0.5, 1)..hsv(237.6, 1, 1)
gene bud_3 = hsv(67.2, 0.62, 1) in hsv(14.4, 0.5, 1)..hsv(237.6, 1, 1)
gene bud_4 = hsv(221.2, 0.75, 1) in hsv(14.4, 0.5, 1)..hsv(237.6, 1, 1)
gene bud_5 = hsv(199.1, 0.99, 1) in hsv(14.4, 0.5, 1)..hsv(237.6, 1, 1)
gene bud_6 = hsv(152.9, 0.75, 1) in hsv(14.4, 0.5, 1)..hsv(237.6, 1, 1)
gene bud_7 = hsv(28.5, 0.65, 1) in hsv(14.4, 0.5, 1)..hsv(237.6, 1, 1)
gene bud_8 = hsv(68.2, 0.58, 1) in hsv(14.4, 0.5, 1)..hsv(237.6, 1, 1)
gene bud_9 = hsv(67.2, 1, 1) in hsv(14.4, 0.5, 1)..hsv(237.6, 1, 1)
gene bud_gap_1 = 0.2924 in 0.01..0.5
gene bud_gap_2 = 0.1628 in 0.01..0.5
gene bud_gap_3 = 0.4259 in 0.01..0.5
gene bud_gap_4 = 0.3102 in 0.01..0.5
gene bud_gap_5 = 0.06613 in 0.01..0.5
gene bud_gap_6 = 0.04631 in 0.01..0.5
gene bud_gap_7 = 0.3345 in 0.01..0.5
gene bud_gap_8 = 0.2428 in 0.01..0.5
gene leaf_1 = hsv(58.1, 0.67, 1) in hsv(14.4, 0.5, 1)..hsv(144, 1, 1)
gene leaf_2 = hsv(48.2, 0.55, 1) in hsv(14.4, 0.5, 1)..hsv(144, 1, 1)
gene leaf_3 = hsv(135.5, 0.69, 1) in hsv(14.4, 0.5, 1)..hsv(144, 1, 1)
gene leaf_4 = hsv(81.9, 0.69, 1) in hsv(14.4, 0.5, 1)..hsv(144, 1, 1)
gene leaf_5 = hsv(108.5, 0.98, 1) in hsv(14.4, 0.5, 1)..hsv(144, 1, 1)
gene leaf_6 = hsv(68, 0.64, 1) in hsv(14.4, 0.5, 1)..hsv(144, 1, 1)
gene leaf_7 = hsv(66.9, 0.66, 1) in hsv(14.4, 0.5, 1)..hsv(144, 1, 1)
gene leaf_8 = hsv(59.6, 0.96, 1) in hsv(14.4, 0.5, 1)..hsv(144, 1, 1)
gene leaf_9 = hsv(74.2, 0.77, 1) in hsv(14.4, 0.5, 1)..hsv(144, 1, 1)
gene leaf_gap_1 = 0.2274 in 0.01..0.5
gene leaf_gap_2 = 0.02196 in 0.01..0.5
gene leaf_gap_3 = 0.08198 in 0.01..0.5
gene leaf_gap_4 = 0.3679 in 0.01..0.5
gene leaf_gap_5 = 0.4242 in 0.01..0.5
gene leaf_gap_6 = 0.1336 in 0.01..0.5
gene leaf_gap_7 = 0.3049 in 0.01..0.5
gene leaf_gap_8 = 0.3177 in 0.01..0.5

let buds = spectrum(bud_1, bud_2 at bud_gap_1, bud_3 at bud_gap_1 + bud_gap_2, bud_4 at bud_gap_1 + bud_gap_2 + bud_gap_3, bud_5 at bud_gap_1 + bud_gap_2 + bud_gap_3 + bud_gap_4, bud_6 at bud_gap_1 + bud_gap_2 + bud_gap_3 + bud_gap_4 + bud_gap_5, bud_7 at bud_gap_1 + bud_gap_2 + bud_gap_3 + bud_gap_4 + bud_gap_5 + bud_gap_6, bud_8 at bud_gap_1 + bud_gap_2 + bud_gap_3 + bud_gap_4 + bud_gap_5 + bud_gap_6 + bud_gap_7, bud_9 at bud_gap_1 + bud_gap_2 + bud_gap_3 + bud_gap_4 + bud_gap_5 + bud_gap_6 + bud_gap_7 + bud_gap_8)
let leaves = spectrum(leaf_1, leaf_2 at leaf_gap_1, leaf_3 at leaf_gap_1 + leaf_gap_2, leaf_4 at leaf_gap_1 + leaf_gap_2 + leaf_gap_3, leaf_5 at leaf_gap_1 + leaf_gap_2 + leaf_gap_3 + leaf_gap_4, leaf_6 at leaf_gap_1 + leaf_gap_2 + leaf_gap_3 + leaf_gap_4 + leaf_gap_5, leaf_7 at leaf_gap_1 + leaf_gap_2 + leaf_gap_3 + leaf_gap_4 + leaf_gap_5 + leaf_gap_6, leaf_8 at leaf_gap_1 + leaf_gap_2 + leaf_gap_3 + leaf_gap_4 + leaf_gap_5 + leaf_gap_6 + leaf_gap_7, leaf_9 at leaf_gap_1 + leaf_gap_2 + leaf_gap_3 + leaf_gap_4 + leaf_gap_5 + leaf_gap_6 + leaf_gap_7 + leaf_gap_8)

shape ball
shine 1
sharpness 1
pitch tilt
repeat floor(segments) + 2 as k {
  let along = k / segments
  // The last segment is cut short by what's left of the count.
  let size = 1
  if k > segments {
    size = segments % 1
  }
  branch {
    pitch lean
    branch {
      branch {
        pitch leaf_angle
        colour leaves(along)
        lay { grow leaf_shape * size }
        forward stalk
        colour buds(along)
        lay { grow size }
      }
      roll leaf_twist
      roll leaf_turn
      colour leaves(along)
      lay { grow (1, 1, second_leaf) * size }
    }
    move (1, 1, offset)
    branch {
      pitch bud_tilt
      branch {
        colour buds(along)
        lay { grow size }
        roll bud_turn
        branch {
          pitch far_angle
          colour leaves(along)
          lay { grow (1, 1, bud_stretch * far_leaf) * size }
          forward far_stalk
          colour buds(along)
          lay { grow (1, 1, bud_stretch) * size }
        }
      }
      move (1, 1, spine)
      colour leaves(along)
      lay { grow size }
    }
  }
  grow growth
  roll twist
}

