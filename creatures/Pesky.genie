creature Pesky
// A spiky blob with four curling tentacles, holding on to a butterfly it has caught.
// Inspired by Pesky, a DancerDNA creature.

gene blob_size = 1.245 in 1..6 // how big the blob is
gene blob_stretch = (0.9827, 1.094, 0.8774) in (0.8, 0.8, 0.8)..(1.2, 1.2, 1.2) // how it's squashed or stretched
gene blob_turn = (-257.9, 167.2, 296.6) in (-343.8, -343.8, -343.8)..(343.8, 343.8, 343.8) // how it's turned: up, sideways and round

gene spike_reach = -3.307 in -15..15 // how far out the spikes are; they never sink into the blob
gene spike_length = 1.453 in 0.5..2
gene spike_spin = -673 in -687.5..687.5 // how far each spike turns round its length

gene leg_tilt = -10.13 in -45.84..45.84 // how far the tentacles tip up or down
gene leg_stride = 0.8957 in 0.7..1.1 // how long their segments are
gene curl = (-59.41, -8.595, 33.61) in (-74.48, -74.48, -74.48)..(74.48, 74.48, 74.48) // how far they curl: up, sideways and round
gene curl_waves = (2.818, 2.798, 2.786) in (1, 1, 1)..(3, 3, 3) // how many half-waves the curling makes along a tentacle
gene swell = (-0.2434, 0.03443, -0.4275) in (-0.7, -0.7, -0.5)..(0.7, 0.7, 0.5) // how much the segments grow and shrink: across, up and along
gene swell_waves = (7.589, 4.477, 5.267) in (0.5, 0.5, 0.5)..(10, 10, 15)
gene swell_start = (0.04555, 0.1333, 0.605) in (0, 0, 0)..(1, 1, 1)

// The blob's colours, from its middle to the tentacles' tips, and the gaps between them.
gene skin_1 = hsv(0.7, 1, 1) in hsv(0, 1, 1)..hsv(252, 1, 1)
gene skin_2 = hsv(216.3, 0.71, 0.42) in hsv(0, 0.6, 0.4)..hsv(252, 1, 1)
gene skin_3 = hsv(91, 0.69, 0.36) in hsv(0, 0.6, 0.1)..hsv(252, 1, 1)
gene skin_4 = hsv(63, 0.74, 0.59) in hsv(0, 0.6, 0.1)..hsv(252, 1, 1)
gene skin_gaps = (0.3973, 0.3537, 0.575) in (0.25, 0.25, 0.25)..(1, 1, 1)

gene victim_reach = 1.14 in 0..12 // how far beyond the spikes the butterfly is
gene victim_turn = (6.431, 40.78, -23.88) in (-343.8, -343.8, -343.8)..(343.8, 343.8, 343.8) // which way it is from the blob
gene victim_body = hsv(37.3, 0.4, 0.65) in hsv(21.6, 0, 0.4)..hsv(54, 1, 1)
gene wing_colour = hsv(24.4, 0.84, 0.98) in hsv(21.6, 0, 0.4)..hsv(54, 1, 1)
gene wing_pattern = hsv(302.8, 1, 1) in hsv(0, 1, 1)..hsv(360, 1, 1)
gene flap = 0.8071 in 0..10 // where the wings are in their beat

let skin = spectrum(skin_1, skin_2 at skin_gaps.x, skin_3 at skin_gaps.x + skin_gaps.y, skin_4 at skin_gaps.x + skin_gaps.y + skin_gaps.z)

let spike_radius = max(spike_reach, blob_size / 2 + spike_length / 3)
let victim_radius = victim_reach + spike_radius + spike_length

pitch 90
yaw 45
blob
spikes
symmetric x {
  branch {
    if side < 0 {
      yaw 90
    }
    legs(leg_tilt * side)
  }
}
victim

part blob {
  branch {
    sharpness 1
    shine 1
    shape ball
    grow blob_size
    reshape { roll blob_turn.z; yaw blob_turn.y; pitch blob_turn.x }
    grow blob_stretch
    pitch -blob_turn.x
    yaw -blob_turn.y
    roll -blob_turn.z
    colour skin_1
    lay
  }
}

part spikes {
  branch {
    sharpness 1
    shine 1
    shape cone
    colour skin_1
    repeat 20 as k {
      branch {
        // Scattered round the blob, in the original's pseudo-random way.
        yaw degrees(k * 312.129)
        pitch degrees(k * 330.5463)
        forward spike_radius
        roll spike_spin
        grow (1, 1, spike_length)
        lay
      }
    }
  }
}

// Two tentacles, one turned right round from the other.
part legs(tilt) {
  branch {
    tentacle(tilt)
    grow (-1, 1, -1)
    tentacle(tilt)
  }
}

part tentacle(tilt) {
  branch {
    forward blob_size / 2
    pitch tilt
    shape ball
    repeat 15 as k {
      let along = k / 14
      colour skin(along)
      sharpness 1 - along
      shine 1 - along
      lay
      forward leg_stride / 2
      yaw curl.y * sin(180 * curl_waves.y * along) ^ 3
      pitch curl.x * sin(180 * curl_waves.x * along) ^ 3
      roll curl.z * sin(180 * curl_waves.z * (along - 1)) ^ 3
      grow (1 + swell.x * sin(180 * swell_waves.x * (along - swell_start.x)) ^ 3, 1 + swell.y * sin(180 * swell_waves.y * (along - swell_start.y)) ^ 3, 1 + swell.z * sin(180 * swell_waves.z * (along - swell_start.z)) ^ 3)
      forward leg_stride / 2
    }
  }
}

part victim {
  branch {
    sharpness 1
    shine 1
    colour victim_body
    shape ball
    pitch victim_turn.x
    yaw victim_turn.y
    roll victim_turn.z
    forward victim_radius
    pitch 90
    lay { grow (0.8, 1, 2) }
    symmetric x {
      wing
    }
  }
}

part wing {
  branch {
    yaw -90
    forward 0.4
    pitch 60 * sin(180 * flap)
    grow (1.3, 0.0001, 2.25)
    forward 0.4
    branch {
      colour wing_colour
      lay
    }
    sharpness 0
    shine 1
    colour wing_pattern
    shape ring
    grow (0.7, 2, 0.7)
    lay { pitch 90 }
  }
}

