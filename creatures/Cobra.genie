creature Cobra
// Two snakes, mirror images of each other, swaying and twisting as they grow, with fins along
// their sides and a pearl in a ring between them.
// Inspired by Cobra, a DancerDNA creature.

gene scales = 1 in 0..1  // how much its skin and pearl wear their textures

gene sway        = 28.09  in -28.65..28.65                         // how far the body sways from side to side
gene sway_waves  = 2.659  in 1..3                                  // how many half-waves the sway makes along the body
gene rise        = -3.236 in -28.65..28.65                         // how far the body rises and falls
gene rise_waves  = 1.111  in 1..3
gene twist       = 3.975  in -28.65..28.65                         // how far the body twists
gene twist_waves = 1      in 1..3
gene taper       = 1.083  in 0.9..1.1                              // how much bigger each segment is than the last
gene offset      = (0, 2.1, 0.9) in (-10, -10, -10)..(10, 10, 10)  // where its middle is: each member's keeps them all in the middle of the view
gene size        = 0.143  in 0.1..2 log                            // how big it is overall: each member's keeps them all about the same size

gene fin       = (1.387, 1.316, 0.5628) in (-2, -2, -2)..(2, 2, 2)  // how far the fins reach: sideways, up and back
gene fin_waves = (2.396, 1.035, 1) in (1, 1, 1)..(3, 3, 3)          // how many half-waves the fins make along the body

// The snakes' colours, from the ends to the middle, and the gaps between them.
gene skin_1    = hsv(89.9, 0.49, 1) in hsv(0, 0.4, 1)..hsv(356.4, 0.6, 1)
gene skin_2    = hsv(112, 0.45, 1) in hsv(0, 0.4, 1)..hsv(356.4, 0.6, 1)
gene skin_3    = hsv(96, 0.59, 1) in hsv(0, 0.4, 1)..hsv(356.4, 0.6, 1)
gene skin_4    = hsv(152.7, 0.45, 1) in hsv(0, 0.4, 1)..hsv(356.4, 0.6, 1)
gene skin_gaps = (0.5861, 0.3406, 0.25) in (0.25, 0.25, 0.25)..(1, 1, 1)

// The fins' colours, in the same way.
gene fin_1    = hsv(54, 1, 1) in hsv(0, 0.8, 0.6)..hsv(237.6, 1, 1)
gene fin_2    = hsv(228.9, 0.98, 0.94) in hsv(0, 0.8, 0.6)..hsv(237.6, 1, 1)
gene fin_3    = hsv(103.2, 0.96, 0.74) in hsv(0, 0.8, 0.6)..hsv(237.6, 1, 1)
gene fin_4    = hsv(82.4, 0.87, 0.65) in hsv(0, 0.8, 0.6)..hsv(237.6, 1, 1)
gene fin_gaps = (0.5613, 0.8866, 0.25) in (0.25, 0.25, 0.25)..(1, 1, 1)

gene pearl_colour = hsv(40.1, 0.65, 0.95) in hsv(18, 0, 0.4)..hsv(54, 1, 1)
gene ring_colour  = hsv(41.3, 0.92, 0.97) in hsv(21.6, 0, 0.4)..hsv(54, 1, 1)
gene pearl_size   = 2.978 in 1.2..3
gene ring_size    = 1.787 in 1.5..2.5
gene ring_tilt    = (207.7, 52.8, 0) in (-343.8, -343.8, -343.8)..(343.8, 343.8, 343.8)  // how the ring turns: up, sideways and round

gene ball_hue   = 125 in 0..360
gene ball_pulse = 90  in 0..90

let skin = spectrum(skin_1, skin_2 at skin_gaps.x, skin_3 at skin_gaps.x + skin_gaps.y, skin_4 at skin_gaps.x + skin_gaps.y + skin_gaps.z)
let fins = spectrum(fin_1, fin_2 at fin_gaps.x, fin_3 at fin_gaps.x + fin_gaps.y, fin_4 at fin_gaps.x + fin_gaps.y + fin_gaps.z)

// Where the pearl goes: the middle of the first snake, measured as it's drawn.
let middle_y = 0
let middle_z = 0

shine 1
sharpness 1
move -offset
grow size
symmetric x {
  snake(side)
}
pearl_ring

part snake(side) {
  let total_y = 0
  let total_z = 0
  shape ball
  repeat 29 as k {
    let along = (k + 1) / 30
    forward 0.45
    yaw sway * sin(180 * sway_waves * along)
    pitch rise * sin(180 * rise_waves * along)
    roll twist * sin(180 * twist_waves * (along - 1))
    grow taper
    forward 0.45
    colour skin(bump(along))
    texture mixed(pattern(kaleidoscope, 47, 35, jewel, pearl), blend, lightning, 0.5)
    wear scales
    total_y += turtle.position.y
    total_z += turtle.position.z
    lay
    branch {
      pitch 90
      let reach = (fin.x * sin(180 * fin_waves.x * along), fin.y * sin(180 * fin_waves.y * along), fin.z * sin(180 * fin_waves.z * (along - 1)))
      move reach
      texture none
      colour fins(bump(along))
      lay { grow reach * 3 }
    }
  }
  if side > 0 {
    middle_y = total_y / 30
    middle_z = total_z / 30
  }
}

part pearl_ring {
  // The middle was measured as drawn: moved by offset and grown by size.
  move (0, middle_y - turtle.position.y, middle_z - turtle.position.z) / size
  shape ball
  colour pearl_colour
  texture mixed(pattern(kaleidoscope, ball_hue + ball_pulse * music.bass, 19, pastel, pearl), blend, lightning, 0.6)
  wear scales
  grow pearl_size
  lay
  pitch ring_tilt.x
  yaw ring_tilt.y
  roll ring_tilt.z
  grow ring_size
  shape ring
  texture none
  colour ring_colour
  lay
}

// Its own dance: Wanderer, the style DancerDNA's Cobra was saved with (as far as can be told).
dance {
  morph   follows music.mid  speed 1.2  settle 0.38
  zoom    follows music.mid_hit  amount 0.5  settle 50
  spin    follows music.level  from 45.8 to 229  smooth 0
  turn    on music.bass changes  by 1
  reverse on music.bass drops  by 1  on 4 off 4
}

