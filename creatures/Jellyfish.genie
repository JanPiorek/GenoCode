creature Jellyfish
// A bell of five curving ribs with skin stretched between them and beads along them, between
// two rings of glowing cubes.
// Inspired by Jellyfish, a DancerDNA creature.

gene textured = false  // whether it wears its texture, as the Neon variant does

gene bell_start   = -94.85  in -114.6..114.6  // how far the ribs tip at the top of the bell
gene bend_1       = 0.4957  in -22.92..22.92  // how far the ribs bend, in two waves added together
gene bend_waves_1 = 3.834   in 1..4
gene bend_start_1 = 0.1518  in -1..1
gene bend_2       = -1.97   in -22.92..22.92
gene bend_waves_2 = 1.41    in 1..4
gene bend_start_2 = 0.04078 in -1..1

gene glow_size       = 1.803 in 0.8..2.5
gene glow_radius     = 34.12 in 20..50
gene glow_turn       = (-0.7045, -7.675, 11.61) in (-57.3, -57.3, -57.3)..(57.3, 57.3, 57.3)  // how far each cube turns from the last: up, sideways and round
gene glow_turn_waves = (1.517, 0.7952, 0.5548) in (0, 0, 0)..(2, 2, 2)
gene glow_turn_start = (0.05573, -0.0008917, 0.1254) in (-0.5, -0.5, -0.5)..(0.5, 0.5, 0.5)

// The skin's and beads' colours, from the top of the bell down, and the gaps between them; and
// the glow, all one hue.
gene skin_1     = hsv(141, 0.37, 0.6) in hsv(0, 0, 0)..hsv(360, 1, 1)
gene skin_2     = hsv(262.3, 0.83, 0.54) in hsv(0, 0, 0)..hsv(360, 1, 1)
gene skin_3     = hsv(250.9, 0.9, 0.43) in hsv(0, 0, 0)..hsv(360, 1, 1)
gene skin_4     = hsv(222.1, 0.47, 0.31) in hsv(0, 0, 0)..hsv(360, 1, 1)
gene skin_gaps  = (0.4264, 0.6327, 0.8156) in (0.25, 0.25, 0.25)..(1, 1, 1)
gene bead_1     = hsv(285.8, 0.58, 1) in hsv(0, 0.4, 1)..hsv(360, 1, 1)
gene bead_2     = hsv(234.3, 0.76, 1) in hsv(0, 0.4, 1)..hsv(360, 1, 1)
gene bead_3     = hsv(273.5, 0.85, 1) in hsv(0, 0.4, 1)..hsv(360, 1, 1)
gene bead_4     = hsv(155.3, 0.88, 1) in hsv(0, 0.4, 1)..hsv(360, 1, 1)
gene bead_gaps  = (0.5986, 0.3542, 0.3142) in (0.25, 0.25, 0.25)..(1, 1, 1)
gene glow_hue   = 104.2  in 0..252
gene glow_sat   = (0.5988, 0.5952, 0.7281) in (0.4, 0.4, 0.4)..(1, 1, 1)  // how strong the glow's colour is: first, middle and last
gene glow_gap_1 = 0.3773 in 0.33..1
gene glow_gap_2 = 0.867  in 0.33..1

let skin = spectrum(skin_1, skin_2 at skin_gaps.x, skin_3 at skin_gaps.x + skin_gaps.y, skin_4 at skin_gaps.x + skin_gaps.y + skin_gaps.z)
let beads = spectrum(bead_1, bead_2 at bead_gaps.x, bead_3 at bead_gaps.x + bead_gaps.y, bead_4 at bead_gaps.x + bead_gaps.y + bead_gaps.z)
let glow_colours = spectrum(hsv(glow_hue, glow_sat.x, 1), hsv(glow_hue, glow_sat.y, 1) at glow_gap_1, hsv(glow_hue, glow_sat.z, 1) at glow_gap_1 + glow_gap_2)

// The middle of the bell, from side to side, measured as the ribs are drawn.
let middle = 0

shine 0
sharpness 0
branch {
  shape tube
  repeat 5 {
    rib
    roll 72
  }
}
forward middle * 2
glow
grow (-1, -1, -1)
glow

part rib {
  let widest = 0
  let narrowest = 0
  branch {
    let angle = bell_start
    let turned = 0
    let out = 0
    let across = 0
    repeat 25 as k {
      let along = k / 25
      pitch angle
      forward 0.6
      turned += angle
      let rise = 0.6 * sin(turned)
      across += 0.6 * cos(turned)
      if across > widest {
        widest = across
      } else if across < narrowest {
        narrowest = across
      }
      let reach = out + rise
      // The skin stretches across to the next rib.
      let width = 2 * abs(reach) * tan(36) - 1.5
      if width > 0.05 {
        branch {
          yaw 90
          colour skin(along)
          if textured {
            colour white
            texture pattern(plasma, skin(along).hue, 6, electric)
          }
          lay { grow (1, 1, width) }
        }
      }
      branch {
        move ((width + 1.5) / 2, 0, 0)
        shape ball
        texture none
        colour beads(along)
        sharpness 1
        shine 1
        lay { grow 1.5 }
      }
      out = reach + rise
      angle = bend_1 * sin(180 * bend_waves_1 * (along + bend_start_1)) + bend_2 * cos(180 * bend_waves_2 * (along + bend_start_2))
      forward 0.6
    }
  }
  middle = (widest + narrowest) / 2
}

// A ring of glowing cubes round the bell.
part glow {
  branch {
    grow glow_size
    sharpness 0
    shine 0
    shape cube
    repeat 30 as k {
      let along = k / 29
      roll glow_turn.z * sin(180 * glow_turn_waves.z * (along + glow_turn_start.z))
      yaw glow_turn.y * sin(180 * glow_turn_waves.y * (along + glow_turn_start.y))
      pitch glow_turn.x * sin(180 * glow_turn_waves.x * (along + glow_turn_start.x))
      colour glow_colours(along)
      branch {
        forward glow_radius
        grow (0.6, 0.25, 0.1)
        lay { roll 45 }
      }
    }
  }
}

