creature Genie
// A pair of curling spirals, mirror images, inside a great swirling ring of flat discs, which
// opens out as the genie comes out of its lamp.
// Inspired by Genie, a DancerDNA creature.

gene out = 0.9594 in 0..1 // how far the genie has come out: 0 keeps it small and tightly wound
gene gloss = 0.2456 in 0..1 // how strong the highlights are
gene focus = 0.3574 in 0..1 // how tight the highlights are

gene spiral_angle = 125.3 in 45..135 // how far the spirals' petals tip out
gene petal_shape = (1, 0.9997, 7.03) in (1, 0.999, -0.322)..(1, 1, 13.68) // how the petals are drawn out
gene petal_out = 3.454 in 0.095..4.1 // how far out the beads beyond the petals are
gene spiral_grow = 1.079 in 1.01..1.1 // how much bigger each turn of a spiral is than the last
gene spiral_roll = -24.86 in -25..25 // how far each turn rolls from the last

gene ring_size = 0.5 in 0.1..1
gene radius = 40.98 in 40..200 // how far out the discs are, when the genie is fully out
gene discs = 96 in 50..100 step 1
gene ring_spread = 39.72 in 0..45.84 // how far the ring of discs twists open

// The colours of the discs round the ring, of the spirals' petals and of their beads, with the
// gaps between them.
gene disc_1 = hsv(283.9, 0.82, 0.07) in hsv(0, 0, 0)..hsv(360, 1, 1)
gene disc_2 = hsv(208.7, 0.8, 0.73) in hsv(0, 0, 0)..hsv(360, 1, 1)
gene disc_3 = hsv(191.1, 0.55, 0.74) in hsv(0, 0, 0)..hsv(360, 1, 1)
gene disc_4 = hsv(102.6, 0.05, 0.24) in hsv(0, 0, 0)..hsv(360, 1, 1)
gene disc_gaps = (0.2264, 0.451, 0.4222) in (0.01, 0.01, 0.01)..(1, 1, 1)
gene petal_1 = hsv(214.3, 0.61, 0.24) in hsv(0, 0, 0)..hsv(360, 1, 1)
gene petal_2 = hsv(48.9, 0.84, 0.64) in hsv(0, 0, 0)..hsv(360, 1, 1)
gene petal_3 = hsv(306.3, 0.84, 0.48) in hsv(0, 0, 0)..hsv(360, 1, 1)
gene petal_4 = hsv(285, 0.94, 0.66) in hsv(0, 0, 0)..hsv(360, 1, 1)
gene petal_gaps = (0.4722, 0.3372, 0.9725) in (0.01, 0.01, 0.01)..(1, 1, 1)
gene bead_1 = hsv(149.7, 0.63, 0.18) in hsv(0, 0, 0)..hsv(360, 1, 1)
gene bead_2 = hsv(151.8, 0.81, 0.53) in hsv(0, 0, 0)..hsv(360, 1, 1)
gene bead_3 = hsv(136.5, 0.11, 0.2) in hsv(0, 0, 0)..hsv(360, 1, 1)
gene bead_4 = hsv(357.9, 0.31, 0.6) in hsv(0, 0, 0)..hsv(360, 1, 1)
gene bead_gaps = (0.08994, 0.2807, 0.6019) in (0.01, 0.01, 0.01)..(1, 1, 1)

let discs_colour = spectrum(disc_1, disc_2 at disc_gaps.x, disc_3 at disc_gaps.x + disc_gaps.y, disc_4 at disc_gaps.x + disc_gaps.y + disc_gaps.z)
let petals = spectrum(petal_1, petal_2 at petal_gaps.x, petal_3 at petal_gaps.x + petal_gaps.y, petal_4 at petal_gaps.x + petal_gaps.y + petal_gaps.z)
let beads = spectrum(bead_1, bead_2 at bead_gaps.x, bead_3 at bead_gaps.x + bead_gaps.y, bead_4 at bead_gaps.x + bead_gaps.y + bead_gaps.z)

shine gloss
sharpness focus
shape ball
symmetric x {
  spiral
}
halo

// A spiral of petals, each with a bead beyond it, which grows as the genie comes out.
part spiral {
  grow max(7 * (out - 0.4), 0.1)
  repeat 20 as k {
    let along = k / 20
    branch {
      pitch spiral_angle
      colour petals(along)
      lay { grow petal_shape }
      forward petal_out
      colour beads(along)
      lay
    }
    grow spiral_grow
    roll spiral_roll
  }
}

part halo {
  let held = 1 - out
  let reach = radius * (1 - held ^ 4)
  let swirl = degrees(0.6 + 8.5 * held ^ 3)
  grow ring_size
  repeat discs as k {
    let along = k / discs
    branch {
      yaw swirl * wave(3 * along)
      forward reach
      colour discs_colour(along)
      lay { grow (10, 10, 0.1) }
    }
    roll (along - 0.5) * ring_spread
    yaw 0.573
    pitch 1.7189
  }
}

