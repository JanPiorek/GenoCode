creature Picstix
// A ball with three coils of rainbow donuts winding out of it, and sometimes a smaller twin.
// Inspired by Picstix, a DancerDNA creature.

gene turn = (-275.4, 241.3, 218.1) in (-355.2, -355.2, -355.2)..(355.2, 355.2, 355.2) // how the creature is turned: up, sideways and round
gene twin_size = -8.124 in -10..3 // how big the twin is; it's left out below 0
gene twin_rise = -38.64 in -355.2..355.2 // which way the twin is from the creature: up
gene twin_swing = 181.8 in -355.2..355.2 // and sideways
gene twin_distance = -21.72 in -30..30
gene twin_turn = (238, -43.79, -330.8) in (-355.2, -355.2, -355.2)..(355.2, 355.2, 355.2) // how the twin is turned

gene focus = 0.7547 in 0..1 // how tight the highlights are
gene ball_colour = hsv(147.4, 1, 1) in hsv(0, 1, 1)..hsv(360, 1, 1)
gene ball_turn = -29.8 in -100..100
gene ball_size = 1.484 in 1..5
gene colour_run = 8.901 in 1..10 // how far along its band of colours each coil's last donut is

gene coil_1_turn = -80.95 in -100..100 // which way the first coil starts
gene coil_1_step = 0.7729 in 0..1 // how far apart its donuts are
gene coil_1_taper = (0.8629, 0.8304, 1) in (0.75, 0.75, 1)..(1.25, 1.25, 1) // how much each donut is squashed from the last
gene coil_1_twist = -242 in -286.5..286.5 // how far each donut rolls from the last
gene bend_1 = (-138.3, 99.47, 178.9) in (-286.5, -286.5, -286.5)..(286.5, 286.5, 286.5) // how the second coil turns from the first
gene coil_2_turn = -47.15 in -100..100
gene coil_2_step = 0.319 in 0..1
gene coil_2_taper = (1.123, 1.175, 1) in (0.75, 0.75, 1)..(1.25, 1.25, 1)
gene coil_2_twist = -95.35 in -286.5..286.5
gene bend_2 = (-46.71, 189.7, 37.27) in (-286.5, -286.5, -286.5)..(286.5, 286.5, 286.5) // how the third coil turns from the second
gene coil_3_turn = -12.35 in -100..100
gene coil_3_step = 1.92 in 0..3
gene coil_3_taper = (1.188, 0.9093, 1) in (0.75, 0.75, 1)..(1.25, 1.25, 1)
gene coil_3_twist = -211.1 in -286.5..286.5

// Each coil's band of colours, and the gaps between them.
gene a_1 = hsv(243.3, 1, 1) in hsv(0, 1, 1)..hsv(360, 1, 1)
gene a_2 = hsv(150.2, 1, 1) in hsv(0, 1, 1)..hsv(360, 1, 1)
gene a_3 = hsv(144.1, 1, 1) in hsv(0, 1, 1)..hsv(360, 1, 1)
gene a_4 = hsv(250.9, 1, 1) in hsv(0, 1, 1)..hsv(360, 1, 1)
gene a_5 = hsv(187.9, 1, 1) in hsv(0, 1, 1)..hsv(360, 1, 1)
gene a_6 = hsv(265.2, 1, 1) in hsv(0, 1, 1)..hsv(360, 1, 1)
gene a_7 = hsv(244.2, 1, 1) in hsv(0, 1, 1)..hsv(360, 1, 1)
gene a_8 = hsv(115.8, 1, 1) in hsv(0, 1, 1)..hsv(360, 1, 1)
gene a_9 = hsv(225.8, 1, 1) in hsv(0, 1, 1)..hsv(360, 1, 1)
gene a_gap_1 = 0.7689 in 0.01..1
gene a_gap_2 = 0.9557 in 0.01..1
gene a_gap_3 = 0.09912 in 0.01..1
gene a_gap_4 = 0.2214 in 0.01..1
gene a_gap_5 = 0.7351 in 0.01..1
gene a_gap_6 = 0.1855 in 0.01..1
gene a_gap_7 = 0.3222 in 0.01..1
gene a_gap_8 = 0.3794 in 0.01..1

gene b_1 = hsv(59.1, 1, 1) in hsv(0, 1, 1)..hsv(360, 1, 1)
gene b_2 = hsv(29.6, 1, 1) in hsv(0, 1, 1)..hsv(360, 1, 1)
gene b_3 = hsv(8.4, 1, 1) in hsv(0, 1, 1)..hsv(360, 1, 1)
gene b_4 = hsv(338.4, 1, 1) in hsv(0, 1, 1)..hsv(360, 1, 1)
gene b_5 = hsv(358, 1, 1) in hsv(0, 1, 1)..hsv(360, 1, 1)
gene b_6 = hsv(296.6, 1, 1) in hsv(0, 1, 1)..hsv(360, 1, 1)
gene b_7 = hsv(74.3, 1, 1) in hsv(0, 1, 1)..hsv(360, 1, 1)
gene b_8 = hsv(319.5, 1, 1) in hsv(0, 1, 1)..hsv(360, 1, 1)
gene b_9 = hsv(90.7, 1, 1) in hsv(0, 1, 1)..hsv(360, 1, 1)
gene b_gap_1 = 0.9057 in 0.01..1
gene b_gap_2 = 0.4056 in 0.01..1
gene b_gap_3 = 0.4704 in 0.01..1
gene b_gap_4 = 0.5038 in 0.01..1
gene b_gap_5 = 0.6624 in 0.01..1
gene b_gap_6 = 0.7508 in 0.01..1
gene b_gap_7 = 0.4162 in 0.01..1
gene b_gap_8 = 0.3893 in 0.01..1

gene c_1 = hsv(37.6, 1, 1) in hsv(0, 1, 1)..hsv(360, 1, 1)
gene c_2 = hsv(303.4, 1, 1) in hsv(0, 1, 1)..hsv(360, 1, 1)
gene c_3 = hsv(229.1, 1, 1) in hsv(0, 1, 1)..hsv(360, 1, 1)
gene c_4 = hsv(94.1, 1, 1) in hsv(0, 1, 1)..hsv(360, 1, 1)
gene c_5 = hsv(118.5, 1, 1) in hsv(0, 1, 1)..hsv(360, 1, 1)
gene c_6 = hsv(137.5, 1, 1) in hsv(0, 1, 1)..hsv(360, 1, 1)
gene c_7 = hsv(28.3, 1, 1) in hsv(0, 1, 1)..hsv(360, 1, 1)
gene c_8 = hsv(202.4, 1, 1) in hsv(0, 1, 1)..hsv(360, 1, 1)
gene c_9 = hsv(242.9, 1, 1) in hsv(0, 1, 1)..hsv(360, 1, 1)
gene c_gap_1 = 0.6931 in 0.01..1
gene c_gap_2 = 0.5463 in 0.01..1
gene c_gap_3 = 0.6459 in 0.01..1
gene c_gap_4 = 0.6112 in 0.01..1
gene c_gap_5 = 0.6996 in 0.01..1
gene c_gap_6 = 0.1032 in 0.01..1
gene c_gap_7 = 0.6503 in 0.01..1
gene c_gap_8 = 0.1828 in 0.01..1

let a_end = band_end(a_gap_1, a_gap_2, a_gap_3, a_gap_4, a_gap_5, a_gap_6, a_gap_7, a_gap_8)
let band_a = spectrum(a_1, a_2 at a_gap_1 / a_end, a_3 at (a_gap_1 + a_gap_2) / a_end, a_4 at (a_gap_1 + a_gap_2 + a_gap_3) / a_end, a_5 at (a_gap_1 + a_gap_2 + a_gap_3 + a_gap_4) / a_end, a_6 at (a_gap_1 + a_gap_2 + a_gap_3 + a_gap_4 + a_gap_5) / a_end, a_7 at (a_gap_1 + a_gap_2 + a_gap_3 + a_gap_4 + a_gap_5 + a_gap_6) / a_end, a_8 at (a_gap_1 + a_gap_2 + a_gap_3 + a_gap_4 + a_gap_5 + a_gap_6 + a_gap_7) / a_end, a_9 at (a_gap_1 + a_gap_2 + a_gap_3 + a_gap_4 + a_gap_5 + a_gap_6 + a_gap_7 + a_gap_8) / a_end)
let b_end = band_end(b_gap_1, b_gap_2, b_gap_3, b_gap_4, b_gap_5, b_gap_6, b_gap_7, b_gap_8)
let band_b = spectrum(b_1, b_2 at b_gap_1 / b_end, b_3 at (b_gap_1 + b_gap_2) / b_end, b_4 at (b_gap_1 + b_gap_2 + b_gap_3) / b_end, b_5 at (b_gap_1 + b_gap_2 + b_gap_3 + b_gap_4) / b_end, b_6 at (b_gap_1 + b_gap_2 + b_gap_3 + b_gap_4 + b_gap_5) / b_end, b_7 at (b_gap_1 + b_gap_2 + b_gap_3 + b_gap_4 + b_gap_5 + b_gap_6) / b_end, b_8 at (b_gap_1 + b_gap_2 + b_gap_3 + b_gap_4 + b_gap_5 + b_gap_6 + b_gap_7) / b_end, b_9 at (b_gap_1 + b_gap_2 + b_gap_3 + b_gap_4 + b_gap_5 + b_gap_6 + b_gap_7 + b_gap_8) / b_end)
let c_end = band_end(c_gap_1, c_gap_2, c_gap_3, c_gap_4, c_gap_5, c_gap_6, c_gap_7, c_gap_8)
let band_c = spectrum(c_1, c_2 at c_gap_1 / c_end, c_3 at (c_gap_1 + c_gap_2) / c_end, c_4 at (c_gap_1 + c_gap_2 + c_gap_3) / c_end, c_5 at (c_gap_1 + c_gap_2 + c_gap_3 + c_gap_4) / c_end, c_6 at (c_gap_1 + c_gap_2 + c_gap_3 + c_gap_4 + c_gap_5) / c_end, c_7 at (c_gap_1 + c_gap_2 + c_gap_3 + c_gap_4 + c_gap_5 + c_gap_6) / c_end, c_8 at (c_gap_1 + c_gap_2 + c_gap_3 + c_gap_4 + c_gap_5 + c_gap_6 + c_gap_7) / c_end, c_9 at (c_gap_1 + c_gap_2 + c_gap_3 + c_gap_4 + c_gap_5 + c_gap_6 + c_gap_7 + c_gap_8) / c_end)

roll turn.z
pitch turn.x
yaw turn.y
picstix
if twin_size >= 0 {
  grow twin_size
  pitch twin_rise
  yaw twin_swing
  forward twin_distance
  roll twin_turn.z
  pitch twin_turn.x
  yaw twin_turn.y
  picstix
}

part picstix {
  branch {
    shine 1
    sharpness focus
    colour ball_colour
    yaw ball_turn
    shape ball
    lay { grow ball_size }
    shape donut
    branch {
      yaw coil_1_turn
      repeat 16 as k {
        colour band_a(k / 16 * colour_run / a_end)
        lay
        forward coil_1_step
        grow coil_1_taper
        roll coil_1_twist
      }
    }
    rotate bend_1.x around (1, 0, 0)
    rotate bend_1.y around (0, 1, 0)
    rotate bend_1.z around (0, 0, 1)
    branch {
      yaw coil_2_turn
      repeat 16 as k {
        colour band_b(k / 16 * colour_run / b_end)
        lay
        forward coil_2_step
        grow coil_2_taper
        roll coil_2_twist
      }
    }
    rotate bend_2.x around (1, 0, 0)
    rotate bend_2.y around (0, 1, 0)
    rotate bend_2.z around (0, 0, 1)
    branch {
      grow (1, 1, 0.5)
      yaw coil_3_turn
      repeat 16 as k {
        colour band_c(k / 16 * colour_run / c_end)
        lay
        forward -coil_3_step
        grow coil_3_taper
        roll coil_3_twist
      }
    }
  }
}

// Where a band's colours end: the original added colours until one reached 1, so later ones
// are never seen.
function band_end(g1, g2, g3, g4, g5, g6, g7, g8) {
  let end = g1
  if end < 1 {
    end += g2
  }
  if end < 1 {
    end += g3
  }
  if end < 1 {
    end += g4
  }
  if end < 1 {
    end += g5
  }
  if end < 1 {
    end += g6
  }
  if end < 1 {
    end += g7
  }
  if end < 1 {
    end += g8
  }
  return end
}

