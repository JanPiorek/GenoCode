  "keywords": [
    "genocode",
    "creatures",
    "generative art",
    "controls",
    "sliders"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/genocode-org/GenoCode.git",
    "directory": "packages/controls"
  },
  "homepage": "https://github.com/genocode-org/GenoCode#readme",
  "bugs": "https://github.com/genocode-org/GenoCode/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@genocode/core": "^0.8.0"
