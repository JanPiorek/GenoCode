{
  "name": "@genocode/core",
  "version": "0.9.0",
  "description": "The GenoCode language: parser, checker, formatter, interpreter and genetics.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/genocode-org/GenoCode.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/genocode-org/GenoCode#readme",
  "bugs": "https://github.com/genocode-org/GenoCode/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./LANGUAGE.md": "./reference/LANGUAGE.md",
    "./creatures/*": "./reference/creatures/*",
    "./dances/*": "./reference/dances/*",
    "./patterns/*": "./reference/patterns/*"
  },
  "files": [
    "dist",
    "reference",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepare": "node scripts/reference.mjs",
    "prepack": "node scripts/reference.mjs"
  },
  "publishConfig": {
    "access": "public"
  }
}
